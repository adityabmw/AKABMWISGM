<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AKA BMW ISGM — Professional</title>

  <meta name="theme-color" content="#030712" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

  <!-- Firebase SDK -->
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <style>
    /* ============================================================
       RESET & ROOT
       ============================================================ */
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Inter',sans-serif; }
    body { background:#0b0f1a; color:#e8edf5; display:flex; min-height:100vh; }
    ::-webkit-scrollbar { width:6px; }
    ::-webkit-scrollbar-track { background:#141b2b; }
    ::-webkit-scrollbar-thumb { background:#2a3a5a; border-radius:4px; }

    /* ============================================================
       TOAST ANIMATION
       ============================================================ */
    @keyframes slideIn {
      from { opacity:0; transform:translateX(30px); }
      to { opacity:1; transform:translateX(0); }
    }

    /* ============================================================
       SIDEBAR
       ============================================================ */
    .sidebar {
      width:250px;
      background:#0f1624;
      border-right:1px solid #1c2740;
      padding:20px 0;
      display:flex;
      flex-direction:column;
      position:fixed;
      top:0;
      left:0;
      height:100vh;
      overflow-y:auto;
      z-index:100;
    }
    .sidebar-brand {
      padding:0 20px 20px 20px;
      display:flex;
      align-items:center;
      gap:10px;
      border-bottom:1px solid #1c2740;
    }
    .sidebar-brand i { font-size:24px; color:#1a8cff; }
    .sidebar-brand span { font-size:18px; font-weight:700; color:#fff; letter-spacing:0.5px; }
    .sidebar-brand small { font-size:11px; color:#6a7e9e; display:block; font-weight:400; }

    .sidebar-group {
      padding:12px 20px 6px 20px;
      font-size:10px;
      text-transform:uppercase;
      color:#4a5e7e;
      font-weight:700;
      letter-spacing:0.5px;
    }
    .sidebar-item {
      display:flex;
      align-items:center;
      gap:12px;
      padding:10px 20px;
      color:#a0b4d0;
      text-decoration:none;
      font-size:14px;
      font-weight:500;
      cursor:pointer;
      transition:0.15s;
      border-left:3px solid transparent;
    }
    .sidebar-item:hover { background:#1a2438; color:#fff; }
    .sidebar-item.active { background:#1a2438; color:#1a8cff; border-left-color:#1a8cff; }
    .sidebar-item i { width:20px; text-align:center; font-size:15px; }

    .sidebar-footer {
      margin-top:auto;
      padding:16px 20px;
      border-top:1px solid #1c2740;
      display:flex;
      align-items:center;
      gap:10px;
    }
    .sidebar-footer img {
      width:32px;
      height:32px;
      border-radius:50%;
      object-fit:cover;
      border:1px solid #2a3a5a;
    }
    .sidebar-footer .user { flex:1; }
    .sidebar-footer .user .name { font-size:13px; font-weight:600; color:#fff; }
    .sidebar-footer .user .role { font-size:11px; color:#6a7e9e; }
    .sidebar-footer .logout { color:#a0b4d0; cursor:pointer; font-size:16px; transition:0.15s; }
    .sidebar-footer .logout:hover { color:#ff5a6a; }

    /* ============================================================
       MAIN CONTENT
       ============================================================ */
    .main {
      margin-left:250px;
      flex:1;
      padding:24px 32px;
      min-height:100vh;
    }

    /* ============================================================
       TOPBAR
       ============================================================ */
    .topbar {
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:24px;
      flex-wrap:wrap;
      gap:12px;
    }
    .topbar h1 { font-size:22px; font-weight:700; color:#fff; }
    .topbar h1 small { font-size:14px; font-weight:400; color:#6a7e9e; margin-left:8px; }
    .topbar-actions {
      display:flex;
      align-items:center;
      gap:16px;
    }
    .topbar-actions .search {
      background:#141b2b;
      border:1px solid #1c2740;
      border-radius:8px;
      padding:6px 14px;
      display:flex;
      align-items:center;
      gap:8px;
    }
    .topbar-actions .search input {
      background:transparent;
      border:none;
      color:#e8edf5;
      font-size:13px;
      outline:none;
      width:160px;
    }
    .topbar-actions .search input::placeholder { color:#4a5e7e; }
    .topbar-actions .search i { color:#4a5e7e; }
    .topbar-actions .notif {
      position:relative;
      color:#a0b4d0;
      font-size:18px;
      cursor:pointer;
    }
    .topbar-actions .notif .badge {
      position:absolute;
      top:-6px;
      right:-8px;
      background:#ff5a6a;
      color:#fff;
      font-size:9px;
      padding:2px 6px;
      border-radius:10px;
    }

    /* ============================================================
       CARDS
       ============================================================ */
    .cards {
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(180px,1fr));
      gap:16px;
      margin-bottom:24px;
    }
    .card-kpi {
      background:#141b2b;
      border:1px solid #1c2740;
      border-radius:12px;
      padding:16px 20px;
      transition:0.15s;
    }
    .card-kpi:hover { border-color:#2a3a5a; }
    .card-kpi .label {
      font-size:12px;
      font-weight:600;
      color:#6a7e9e;
      text-transform:uppercase;
      letter-spacing:0.3px;
    }
    .card-kpi .value {
      font-size:28px;
      font-weight:700;
      color:#fff;
      margin-top:4px;
    }
    .card-kpi .change {
      font-size:12px;
      font-weight:600;
      margin-top:2px;
    }
    .card-kpi .change.up { color:#2ecc71; }
    .card-kpi .change.down { color:#ff5a6a; }

    /* ============================================================
       PANELS
       ============================================================ */
    .panels {
      display:grid;
      grid-template-columns:1.4fr 1fr;
      gap:20px;
      margin-bottom:24px;
    }
    .panel {
      background:#141b2b;
      border:1px solid #1c2740;
      border-radius:12px;
      padding:18px 20px;
    }
    .panel-title {
      font-size:14px;
      font-weight:600;
      color:#fff;
      margin-bottom:14px;
      display:flex;
      justify-content:space-between;
      align-items:center;
    }
    .panel-title .action {
      font-size:12px;
      color:#1a8cff;
      cursor:pointer;
    }

    /* ============================================================
       TABLE
       ============================================================ */
    .table-wrap { overflow-x:auto; }
    .table-wrap table { width:100%; border-collapse:collapse; font-size:13px; }
    .table-wrap th {
      text-align:left;
      padding:10px 6px;
      color:#6a7e9e;
      font-weight:600;
      border-bottom:1px solid #1c2740;
      font-size:11px;
      text-transform:uppercase;
    }
    .table-wrap td {
      padding:10px 6px;
      border-bottom:1px solid #1c2740;
      color:#e8edf5;
    }
    .table-wrap .badge {
      font-size:10px;
      padding:2px 10px;
      border-radius:12px;
      font-weight:600;
    }
    .badge-proses { background:#1a3a5a; color:#4a9eff; }
    .badge-selesai { background:#1a3a2a; color:#2ecc71; }
    .badge-waiting { background:#4a3a1a; color:#f1c40f; }
    .badge-paid { background:#1a3a2a; color:#2ecc71; }
    .badge-unpaid { background:#3a1a1a; color:#ff5a6a; }
    .badge-status {
      font-size:10px;
      padding:2px 10px;
      border-radius:12px;
      font-weight:600;
    }
    .b-proses { background:#1a3a5a; color:#4a9eff; }
    .b-parts { background:#4a3a1a; color:#f1c40f; }
    .b-diag { background:#3a1a3a; color:#c084fc; }

    /* ============================================================
       QUICK ACTIONS
       ============================================================ */
    .quick-actions {
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-top:12px;
    }
    .quick-actions button {
      background:#1c2740;
      border:none;
      border-radius:8px;
      padding:8px 18px;
      color:#e8edf5;
      font-weight:500;
      font-size:13px;
      display:flex;
      align-items:center;
      gap:8px;
      transition:0.15s;
    }
    .quick-actions button:hover { background:#2a3a5a; }
    .quick-actions .primary { background:#1a8cff; color:#fff; }
    .quick-actions .primary:hover { background:#1a7ae0; }

    /* ============================================================
       VIEWS
       ============================================================ */
    .view { display:none; }
    .view.active { display:block; }
    .d-none { display:none !important; }

    /* ============================================================
       FORMS
       ============================================================ */
    .form-card {
      background:#141b2b;
      border:1px solid #1c2740;
      border-radius:12px;
      padding:20px;
      margin-bottom:20px;
    }
    .form-card .row {
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(180px,1fr));
      gap:12px;
    }
    .form-card label {
      font-size:12px;
      font-weight:600;
      color:#6a7e9e;
      margin-bottom:4px;
      display:block;
    }
    .form-card input,
    .form-card select {
      width:100%;
      background:#0b0f1a;
      border:1px solid #1c2740;
      border-radius:8px;
      padding:8px 12px;
      color:#e8edf5;
      font-size:13px;
      outline:none;
    }
    .form-card input:focus,
    .form-card select:focus { border-color:#1a8cff; }
    .form-card button {
      background:#1a8cff;
      border:none;
      border-radius:8px;
      padding:8px 20px;
      color:#fff;
      font-weight:600;
      font-size:13px;
      cursor:pointer;
      transition:0.15s;
    }
    .form-card button:hover { background:#1a7ae0; }
    .form-card .btn-warning { background:#f39c12; }
    .form-card .btn-warning:hover { background:#d68910; }
    .form-card .btn-success { background:#2ecc71; }
    .form-card .btn-success:hover { background:#27ae60; }
    .form-card .btn-danger { background:#ff5a6a; }
    .form-card .btn-danger:hover { background:#e74c3c; }

    /* ============================================================
       LIVE WO & MECHANIC PROGRESS
       ============================================================ */
    .live-wo-item {
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:8px 0;
      border-bottom:1px solid #1c2740;
    }
    .live-wo-left {
      display:flex;
      align-items:center;
      gap:10px;
    }
    .live-wo-thumb {
      width:40px;
      height:40px;
      border-radius:8px;
      object-fit:cover;
    }
    .live-wo-info .w-no { font-size:13px; font-weight:600; color:#fff; }
    .live-wo-info .w-desc { font-size:11px; color:#6a7e9e; }
    .live-wo-right .badge-status { font-size:9px; }

    .mech-progress-row {
      display:flex;
      align-items:center;
      gap:10px;
      padding:4px 0;
    }
    .mech-profile-box {
      display:flex;
      align-items:center;
      gap:6px;
      min-width:70px;
    }
    .mech-mini-avatar {
      width:24px;
      height:24px;
      border-radius:50%;
      object-fit:cover;
    }
    .mech-pbar-container {
      flex:1;
      height:6px;
      background:#1c2740;
      border-radius:4px;
      overflow:hidden;
    }
    .mech-pbar-fill {
      height:100%;
      background:linear-gradient(90deg,#1a8cff,#06d6a0);
      border-radius:4px;
      transition:width 0.5s ease;
    }

    /* ============================================================
       RESPONSIVE
       ============================================================ */
    @media (max-width:768px) {
      .sidebar {
        width:60px;
        padding:10px 0;
      }
      .sidebar-brand span,
      .sidebar-brand small,
      .sidebar-group,
      .sidebar-item span { display:none; }
      .sidebar-item { padding:12px 18px; justify-content:center; }
      .sidebar-footer .user { display:none; }
      .main { margin-left:60px; padding:16px; }
      .panels { grid-template-columns:1fr; }
      .topbar h1 { font-size:18px; }
      .topbar-actions .search input { width:100px; }
    }
    @media (max-width:480px) {
      .cards { grid-template-columns:1fr 1fr; }
      .form-card .row { grid-template-columns:1fr; }
    }
  </style>
</head>
<body>

<!-- ============================================================
     SIDEBAR
     ============================================================ -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <i class="fas fa-car"></i>
    <div>
      <span>AKA BMW</span>
      <small>ISGM</small>
    </div>
  </div>

  <div class="sidebar-group">Manajemen</div>
  <a class="sidebar-item active" id="navDash" data-view="dashboard"><i class="fas fa-chart-pie"></i><span>Dashboard</span></a>
  <a class="sidebar-item" id="navCust" data-view="customers"><i class="fas fa-users"></i><span>Customer</span></a>
  <a class="sidebar-item" id="navVehicle" data-view="vehicles"><i class="fas fa-car-side"></i><span>Kendaraan</span></a>
  <a class="sidebar-item" id="navParts" data-view="inventory"><i class="fas fa-boxes"></i><span>Inventaris</span></a>

  <div class="sidebar-group">Transaksi</div>
  <a class="sidebar-item" id="navWO" data-view="workorders"><i class="fas fa-clipboard-list"></i><span>Work Order</span></a>
  <a class="sidebar-item" id="navInvoice" data-view="invoice"><i class="fas fa-file-invoice-dollar"></i><span>Invoice</span></a>
  <a class="sidebar-item" id="navEstimation" data-view="estimation"><i class="fas fa-calculator"></i><span>Estimasi</span></a>
  <a class="sidebar-item" id="navRec" data-view="reception"><i class="fas fa-door-open"></i><span>Check-in</span></a>

  <div class="sidebar-group">Laporan & Sistem</div>
  <a class="sidebar-item" id="navReports" data-view="reports"><i class="fas fa-chart-bar"></i><span>Laporan</span></a>
  <a class="sidebar-item" id="navReminder" data-view="reminder"><i class="fas fa-bell"></i><span>Reminder Service</span></a>
  <a class="sidebar-item" id="navUsers" data-view="users"><i class="fas fa-user-cog"></i><span>User Management</span></a>
  <a class="sidebar-item" id="navBackup" data-view="backup"><i class="fas fa-database"></i><span>Backup & Restore</span></a>

  <div class="sidebar-group">Tools</div>
  <a class="sidebar-item" id="navRadar" data-view="radar"><i class="fas fa-radar"></i><span>Vehicle Radar</span></a>
  <a class="sidebar-item" id="navAskAka" data-view="askaka"><i class="fas fa-brain"></i><span>ASK AKA AI</span></a>
  <a class="sidebar-item" id="navBmwEtk" data-view="bmwetk"><i class="fas fa-book"></i><span>BMW ETK</span></a>
  <a class="sidebar-item" id="navWiring" data-view="wiring"><i class="fas fa-bolt"></i><span>Wiring Diagram</span></a>
  <a class="sidebar-item" id="navWhitespace" data-view="whatsapp"><i class="fab fa-whatsapp"></i><span>WhatsApp Center</span></a>

  <div class="sidebar-footer">
    <img src="https://ui-avatars.com/api/?name=Pak+Adit&background=1a8cff&color=fff&size=32" alt="avatar" />
    <div class="user">
      <div class="name" id="topbarUserName">Pak Adit</div>
      <div class="role" id="currentUserRole">Owner</div>
    </div>
    <i class="fas fa-sign-out-alt logout" id="btnSignOutClick"></i>
  </div>
</aside>

<!-- ============================================================
     MAIN CONTENT
     ============================================================ -->
<main class="main" id="dashboardPage">

  <!-- TOPBAR -->
  <div class="topbar">
    <h1 id="pageTitle">Dashboard <small>Ringkasan hari ini</small></h1>
    <div class="topbar-actions">
      <div class="search">
        <i class="fas fa-search"></i>
        <input type="text" id="globalSearch" placeholder="Cepat cari..." />
      </div>
      <div class="notif">
        <i class="fas fa-bell"></i>
        <span class="badge">3</span>
      </div>
    </div>
  </div>

  <!-- ============================================================
       VIEW: DASHBOARD
       ============================================================ -->
  <div class="view active" id="dashboardView">
    <div class="cards" id="kpiContainer">
      <div class="card-kpi">
        <div class="label">Total Customer</div>
        <div class="value" id="kpiTotalCustomer">0</div>
        <div class="change up">+12%</div>
      </div>
      <div class="card-kpi">
        <div class="label">Kendaraan</div>
        <div class="value" id="kpiTotalVehicle">0</div>
        <div class="change up">+8%</div>
      </div>
      <div class="card-kpi">
        <div class="label">WO Aktif</div>
        <div class="value" id="totalWO">0</div>
        <div class="change up">+15%</div>
      </div>
      <div class="card-kpi">
        <div class="label">Invoice Hari Ini</div>
        <div class="value" id="cardInvoice">0</div>
        <div class="change down">-2%</div>
      </div>
    </div>

    <div class="panels">
      <div class="panel">
        <div class="panel-title">
          Work Order Terbaru
          <span class="action" id="lihatSemuaWO">Lihat semua →</span>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>No WO</th><th>Customer</th><th>Status</th></tr>
            </thead>
            <tbody id="woPreviewList"></tbody>
          </table>
        </div>
      </div>
      <div class="panel">
        <div class="panel-title">Aktivitas Terakhir</div>
        <div id="activityLog" style="font-size:13px;color:#a0b4d0;max-height:200px;overflow-y:auto;white-space:pre-wrap;"></div>
      </div>
    </div>

    <div class="quick-actions">
      <button class="primary" id="qaNewWO"><i class="fas fa-plus"></i> WO Baru</button>
      <button class="primary" id="qaNewCustomer"><i class="fas fa-user-plus"></i> Customer Baru</button>
      <button class="primary" id="qaInvoice"><i class="fas fa-file-invoice"></i> Invoice</button>
      <button id="qaCheckin"><i class="fas fa-door-open"></i> Check-in</button>
    </div>
  </div>

  <!-- ============================================================
       VIEW: CUSTOMERS
       ============================================================ -->
  <div class="view" id="customerView">
    <div class="form-card">
      <div class="row">
        <div>
          <label>Nama</label>
          <input id="customerName" placeholder="Nama customer" />
        </div>
        <div>
          <label>WhatsApp</label>
          <input id="customerPhone" placeholder="08xxxx" />
        </div>
        <div>
          <label>Alamat</label>
          <input id="customerAddress" placeholder="Alamat" />
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnAddCustomer"><i class="fas fa-save"></i> Simpan</button>
        </div>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Nama</th><th>WA</th><th>Alamat</th><th>Total Transaksi</th><th>Poin</th></tr>
        </thead>
        <tbody id="customerTable"></tbody>
      </table>
    </div>
  </div>

  <!-- ============================================================
       VIEW: VEHICLES
       ============================================================ -->
  <div class="view" id="vehicleView">
    <div class="form-card">
      <div class="row">
        <div>
          <label>Customer</label>
          <select id="vehicleCustomer"><option value="">Pilih</option></select>
        </div>
        <div>
          <label>Plat</label>
          <input id="vehiclePlate" placeholder="B 1234 XYZ" />
        </div>
        <div>
          <label>VIN</label>
          <input id="vehicleVin" placeholder="VIN" />
        </div>
        <div>
          <label>Model</label>
          <input id="vehicleModel" placeholder="BMW 320i" />
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnAddVehicle"><i class="fas fa-save"></i> Simpan</button>
        </div>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Plat</th><th>Model</th><th>Owner</th><th>VIN</th></tr>
        </thead>
        <tbody id="vehicleTable"></tbody>
      </table>
    </div>
  </div>

  <!-- ============================================================
       VIEW: INVENTORY
       ============================================================ -->
  <div class="view" id="inventoryView">
    <div class="form-card">
      <div class="row">
        <div>
          <label>Part Number</label>
          <input id="partNumber" placeholder="112..." />
        </div>
        <div>
          <label>Nama Part</label>
          <input id="partName" placeholder="Filter oli" />
        </div>
        <div>
          <label>Stok</label>
          <input id="partStock" type="number" value="0" />
        </div>
        <div>
          <label>Harga Jual</label>
          <input id="partSellPrice" type="number" value="0" />
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnAddInventory"><i class="fas fa-plus"></i> Tambah</button>
        </div>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Part No</th><th>Nama</th><th>Stok</th><th>Harga</th></tr>
        </thead>
        <tbody id="inventoryTable"></tbody>
      </table>
    </div>
  </div>

  <!-- ============================================================
       VIEW: WORK ORDERS
       ============================================================ -->
  <div class="view" id="workOrderView">
    <div class="form-card">
      <div class="row">
        <div>
          <label>Customer</label>
          <select id="woCustomer"><option value="">Pilih</option></select>
        </div>
        <div>
          <label>Kendaraan</label>
          <select id="woVehicle"><option value="">Pilih</option></select>
        </div>
        <div>
          <label>Mekanik</label>
          <input id="woTechnician" placeholder="Nama mekanik" />
        </div>
        <div>
          <label>SA</label>
          <input id="woServiceAdvisor" placeholder="Service Advisor" />
        </div>
        <div>
          <label>Biaya Jasa</label>
          <input id="woLaborPrice" type="number" value="0" />
        </div>
        <div>
          <label>Status</label>
          <select id="woStatus">
            <option value="PROSES">Proses</option>
            <option value="SELESAI">Selesai</option>
            <option value="WAITING_PARTS">Waiting Parts</option>
          </select>
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnCreateWO"><i class="fas fa-plus"></i> Buat WO</button>
        </div>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>WO</th><th>Customer</th><th>Status</th><th>Progress</th></tr>
        </thead>
        <tbody id="workOrderTable"></tbody>
      </table>
    </div>
  </div>

  <!-- ============================================================
       VIEW: INVOICE
       ============================================================ -->
  <div class="view" id="invoiceView">
    <div class="form-card">
      <div class="row">
        <div>
          <label>WO</label>
          <select id="invoiceWO"><option value="">Pilih WO</option></select>
        </div>
        <div>
          <label>Customer</label>
          <input id="invoiceCustomer" readonly />
        </div>
        <div>
          <label>Total</label>
          <input id="invoiceGrandTotal" readonly />
        </div>
        <div>
          <label>Status</label>
          <select id="invoiceStatusInput">
            <option value="PAID">PAID</option>
            <option value="UNPAID">UNPAID</option>
          </select>
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnSaveInvoice"><i class="fas fa-file-invoice"></i> Terbitkan</button>
        </div>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Invoice</th><th>Customer</th><th>Total</th><th>Status</th></tr>
        </thead>
        <tbody id="invoiceTable"></tbody>
      </table>
    </div>
  </div>

  <!-- ============================================================
       VIEW: ESTIMATION
       ============================================================ -->
  <div class="view" id="estimationView">
    <div class="form-card">
      <div class="row">
        <div>
          <label>WO</label>
          <select id="estimationWO"><option value="">Pilih WO</option></select>
        </div>
        <div>
          <label>Customer</label>
          <input id="estimationCustomer" readonly />
        </div>
        <div>
          <label>Total Estimasi</label>
          <input id="estimationGrandTotal" readonly />
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnSaveEstimation"><i class="fas fa-save"></i> Simpan Estimasi</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       VIEW: RECEPTION (Check-in)
       ============================================================ -->
  <div class="view" id="receptionView">
    <div class="form-card">
      <div class="row">
        <div>
          <label>Customer</label>
          <select id="checkinCustomer"><option value="">Pilih</option></select>
        </div>
        <div>
          <label>Plat</label>
          <input id="checkinPlate" placeholder="Plat" />
        </div>
        <div>
          <label>VIN</label>
          <input id="checkinVin" placeholder="VIN" />
        </div>
        <div>
          <label>Model</label>
          <input id="checkinModel" placeholder="Model" />
        </div>
        <div>
          <label>KM</label>
          <input id="checkinKm" type="number" value="0" />
        </div>
        <div>
          <label>Keluhan</label>
          <input id="checkinComplaint" placeholder="Keluhan" />
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnCheckIn"><i class="fas fa-door-open"></i> Check-in</button>
        </div>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>No Check-in</th><th>Customer</th><th>Plat</th><th>Status</th></tr>
        </thead>
        <tbody id="recentCheckinList"></tbody>
      </table>
    </div>
  </div>

  <!-- ============================================================
       VIEW: REPORTS
       ============================================================ -->
  <div class="view" id="reportsView">
    <div class="panel" style="border:1px solid #1c2740;border-radius:12px;padding:20px;">
      <div class="panel-title">Laporan Pendapatan</div>
      <div style="height:200px;"><canvas id="reportChart"></canvas></div>
      <div style="margin-top:16px;display:flex;gap:16px;flex-wrap:wrap;">
        <button class="btn btn-primary" id="exportExcel"><i class="fas fa-file-excel"></i> Export Excel</button>
        <button class="btn btn-success" id="exportPDF"><i class="fas fa-file-pdf"></i> Export PDF</button>
      </div>
    </div>
  </div>

  <!-- ============================================================
       VIEW: REMINDER
       ============================================================ -->
  <div class="view" id="reminderView">
    <div class="panel" style="border:1px solid #1c2740;border-radius:12px;padding:20px;">
      <div class="panel-title">
        Reminder Service
        <span class="action" id="refreshReminder"><i class="fas fa-sync"></i> Refresh</span>
      </div>
      <div id="reminderList" style="font-size:14px;"></div>
    </div>
  </div>

  <!-- ============================================================
       VIEW: USER MANAGEMENT
       ============================================================ -->
  <div class="view" id="usersView">
    <div class="form-card">
      <div class="row">
        <div>
          <label>Email</label>
          <input id="userEmail" placeholder="user@email.com" />
        </div>
        <div>
          <label>Password</label>
          <input id="userPass" type="password" placeholder="****" />
        </div>
        <div>
          <label>Role</label>
          <select id="userRoleSelect">
            <option value="OWNER">OWNER</option>
            <option value="ADMIN">ADMIN</option>
            <option value="SERVICE_ADVISOR">SERVICE_ADVISOR</option>
            <option value="TECHNICIAN">TECHNICIAN</option>
            <option value="PARTS">PARTS</option>
            <option value="CASHIER">CASHIER</option>
          </select>
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnAddUser"><i class="fas fa-user-plus"></i> Tambah User</button>
        </div>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Email</th><th>Role</th><th>UID</th></tr>
        </thead>
        <tbody id="userTable"></tbody>
      </table>
    </div>
  </div>

  <!-- ============================================================
       VIEW: BACKUP & RESTORE
       ============================================================ -->
  <div class="view" id="backupView">
    <div class="panel" style="border:1px solid #1c2740;border-radius:12px;padding:20px;">
      <div class="panel-title">Backup & Restore</div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:8px;">
        <button class="btn btn-primary" id="btnBackup"><i class="fas fa-download"></i> Backup Data</button>
        <button class="btn btn-warning" id="btnRestore"><i class="fas fa-upload"></i> Restore Data</button>
        <span style="color:#6a7e9e;font-size:13px;align-self:center;">Terakhir backup: <span id="lastBackupTime">-</span></span>
      </div>
    </div>
  </div>

  <!-- ============================================================
       VIEW: VEHICLE RADAR
       ============================================================ -->
  <div class="view" id="vehicleRadarView">
    <div class="form-card">
      <div class="row">
        <div style="flex:3;">
          <label>Cari Nopol / VIN</label>
          <input id="radarSearchInput" placeholder="B 1234 XYZ atau VIN..." />
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnSearchRadar"><i class="fas fa-radar"></i> Scan</button>
        </div>
      </div>
    </div>
    <div id="radarResultSection" class="d-none">
      <div class="panel" style="border:1px solid #1c2740;border-radius:12px;padding:20px;margin-bottom:20px;">
        <div class="panel-title">Profile Kendaraan</div>
        <div class="row" id="radarProfileData"></div>
      </div>
      <div class="panel" style="border:1px solid #1c2740;border-radius:12px;padding:20px;">
        <div class="panel-title">Riwayat Service</div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Tanggal</th><th>WO</th><th>SA</th><th>Total</th><th>Status</th><th>WA</th></tr>
            </thead>
            <tbody id="radarHistoryTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       VIEW: ASK AKA AI
       ============================================================ -->
  <div class="view" id="askAkaView">
    <div class="form-card">
      <div class="row">
        <div style="flex:3;">
          <label>Tanya AI Mekanik</label>
          <input id="aiSearchQuery" placeholder="e.g. 'E46 cluster mati' atau 'dtc 2A82'" />
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnAskAi"><i class="fas fa-brain"></i> Tanya</button>
        </div>
      </div>
    </div>
    <div id="aiResponseContainer" class="d-none">
      <div class="panel" style="border:1px solid #1c2740;border-radius:12px;padding:20px;">
        <div class="panel-title">Jawaban AI</div>
        <div id="aiResponseOutput" style="font-size:14px;line-height:1.6;color:#e8edf5;"></div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       VIEW: BMW ETK
       ============================================================ -->
  <div class="view" id="bmwEtkView">
    <div class="form-card">
      <div class="row">
        <div>
          <label>VIN</label>
          <input id="etkVin" placeholder="Masukkan VIN" />
        </div>
        <div>
          <label>Part Number</label>
          <input id="etkPartNumber" placeholder="Masukkan Part No" />
        </div>
        <div style="display:flex;align-items:end;">
          <button id="btnEtkSearch"><i class="fas fa-search"></i> Cari</button>
        </div>
      </div>
    </div>
    <div class="panel" style="border:1px solid #1c2740;border-radius:12px;padding:20px;">
      <div class="panel-title">BMW ETK — Parts Catalog</div>
      <p style="color:#6a7e9e;font-size:13px;">
        Masukkan VIN untuk melihat parts catalog di BMW BimmerRefs, atau masukkan Part Number untuk cek stok di gudang AKA.
      </p>
    </div>
  </div>

  <!-- ============================================================
       VIEW: WIRING DIAGRAM
       ============================================================ -->
  <div class="view" id="wiringDiagramView">
    <div class="panel" style="border:1px solid #1c2740;border-radius:12px;padding:20px;">
      <div class="panel-title">WDS & TIS</div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:8px;">
        <button class="btn btn-primary" id="btnWdsMain"><i class="fas fa-bolt"></i> WDS (Wiring Diagram)</button>
        <button class="btn btn-success" id="btnWdsTis"><i class="fas fa-book"></i> TIS (Technical Info)</button>
      </div>
      <p style="color:#6a7e9e;font-size:13px;margin-top:12px;">
        WDS: Wiring Diagram System — diagram kelistrikan BMW.<br />
        TIS: Technical Information System — prosedur perbaikan resmi BMW.
      </p>
    </div>
  </div>

  <!-- ============================================================
       VIEW: WHATSAPP CENTER
       ============================================================ -->
  <div class="view" id="whatsappCenterView">
    <div class="panels" style="grid-template-columns:1fr 2fr;">
      <div class="panel" style="border:1px solid #1c2740;border-radius:12px;padding:18px 20px;">
        <div class="panel-title">Chats</div>
        <div id="waTerminalChatList" class="d-flex flex-column gap-1"></div>
      </div>
      <div class="panel" style="border:1px solid #1c2740;border-radius:12px;padding:18px 20px;display:flex;flex-direction:column;">
        <div class="panel-title" id="waChatActiveTitle">Pilih Chat</div>
        <div id="waChatActiveMessages" style="flex:1;overflow-y:auto;max-height:300px;font-size:13px;padding:8px 0;"></div>
        <div class="d-flex gap-2 mt-2">
          <input id="waTerminalInputText" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Ketik pesan..." />
          <button id="btnWaTerminalSend" class="btn btn-sm btn-success"><i class="fab fa-whatsapp"></i> Kirim</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
       AUTH PAGE (Overlay)
       ============================================================ -->
  <div id="authPage" class="d-none" style="position:fixed;top:0;left:0;width:100%;height:100%;background:#0b0f1a;display:flex;align-items:center;justify-content:center;z-index:9999;">
    <div style="background:#141b2b;border:1px solid #1c2740;border-radius:16px;padding:40px;width:100%;max-width:400px;">
      <div style="text-align:center;margin-bottom:24px;">
        <i class="fas fa-car" style="font-size:36px;color:#1a8cff;"></i>
        <h2 style="color:#fff;margin-top:8px;">AKA BMW ISGM</h2>
        <p style="color:#6a7e9e;font-size:13px;">Integrated System Gateway Management</p>
      </div>
      <form id="loginForm">
        <div style="margin-bottom:16px;">
          <label style="color:#6a7e9e;font-size:12px;font-weight:600;">Email</label>
          <input id="loginEmail" type="email" class="form-control bg-dark text-white border-secondary" placeholder="Email" />
        </div>
        <div style="margin-bottom:16px;position:relative;">
          <label style="color:#6a7e9e;font-size:12px;font-weight:600;">Password</label>
          <input id="loginPassword" type="password" class="form-control bg-dark text-white border-secondary" placeholder="Password" />
          <i id="togglePasswordVisBtn" class="fa-regular fa-eye-slash" style="position:absolute;right:12px;bottom:12px;color:#4a5e7e;cursor:pointer;"></i>
        </div>
        <div style="margin-bottom:20px;">
          <label style="color:#6a7e9e;font-size:12px;font-weight:600;">Role</label>
          <select id="loginRole" class="form-control bg-dark text-white border-secondary">
            <option value="OWNER">Owner</option>
            <option value="ADMIN">Admin</option>
            <option value="SERVICE_ADVISOR">Service Advisor</option>
            <option value="TECHNICIAN">Technician</option>
            <option value="PARTS">Parts</option>
            <option value="CASHIER">Cashier</option>
          </select>
        </div>
        <button id="btnLogin" type="submit" class="btn btn-primary w-100">Login</button>
      </form>
      <p style="text-align:center;color:#4a5e7e;font-size:12px;margin-top:12px;">
        Demo: owner@akabmw.com / SecurePass123!
      </p>
    </div>
  </div>

  <!-- ============================================================
       TOAST CONTAINER
       ============================================================ -->
  <div id="toastContainer"></div>

  <!-- ============================================================
       LOADING SCREEN
       ============================================================ -->
  <div id="loadingScreen" style="position:fixed;top:0;left:0;width:100%;height:100%;background:#0b0f1a;display:flex;align-items:center;justify-content:center;z-index:99999;">
    <div style="text-align:center;">
      <i class="fas fa-car" style="font-size:48px;color:#1a8cff;animation:pulse 1s infinite;"></i>
      <p style="color:#6a7e9e;margin-top:12px;">Loading AKA BMW ISGM...</p>
    </div>
  </div>

</main>

<!-- ============================================================
     SCRIPTS
     ============================================================ -->
<script src="js/app.js"></script>

</body>
</html>