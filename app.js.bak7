    createdAt: new Date().toISOString()
  };
  await addDoc(collection(db, "suppliers"), data);
  alert("✅ Berhasil meregistrasikan mitra supplier baru!");
  ["supplierName","supplierPIC","supplierPhone","supplierWhatsapp","supplierEmail","supplierAddress"].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = "";
  });
