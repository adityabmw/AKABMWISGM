// 2. CRM: Tambah follow-up
window.addFollowUp = async function(customerId, note) {
  if (!customerId || !note) {
    showToast('Customer ID dan note wajib diisi!', 'warning');
    return;
  }
  try {
    const docRef = await db.collection('crm_followups').add({
      customerId,
      note,
      status: 'PENDING',
      createdAt: firebase.firestore.FieldValue.serverTimestamp()
    });
    showToast('✅ Follow-up berhasil ditambahkan!', 'success');
    return docRef.id;
  } catch (err) {
    showToast('❌ ' + err.message, 'error');
  }
};

// 3. Knowledge Base: Cari artikel
window.searchKnowledge = async function(keyword) {
  if (!keyword) {
    showToast('Masukkan kata kunci!', 'warning');
    return;
  }
  try {
    const snap = await db.collection('knowledge_base').get();
    const results = snap.docs
      .map(d => ({ id: d.id, ...d.data() }))
      .filter(a => 
        a.title?.toLowerCase().includes(keyword.toLowerCase()) ||
        a.content?.toLowerCase().includes(keyword.toLowerCase())
      );
    if (results.length === 0) {
      showToast('Tidak ditemukan artikel untuk "' + keyword + '"', 'info');
    } else {
      showToast('📚 Ditemukan ' + results.length + ' artikel', 'success');
      console.log('📚 Hasil pencarian:', results);
    }
    return results;
  } catch (err) {
    showToast('❌ ' + err.message, 'error');
  }
};

// 4. History: Lihat riwayat kendaraan
window.getVehicleHistory = async function(vehicleId) {
  if (!vehicleId) {
    showToast('Masukkan Vehicle ID!', 'warning');
    return;
  }
  try {
    const snap = await db.collection('work_orders')
      .where('vehicleId', '==', vehicleId)
      .orderBy('createdAt', 'desc')
      .get();
    const history = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    if (history.length === 0) {
      showToast('Tidak ada riwayat servis untuk kendaraan ini', 'info');
    } else {
      showToast('📜 Ditemukan ' + history.length + ' riwayat servis', 'success');
      console.log('📜 Riwayat:', history);
    }
    return history;
  } catch (err) {
    showToast('❌ ' + err.message, 'error');
  }
};

console.log('✅ Modul baru: Chart, CRM, Knowledge, History terintegrasi!');

