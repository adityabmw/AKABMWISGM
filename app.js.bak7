  const form = document.getElementById('knowledgeForm');
  if (form) form.classList.remove('hidden');
  const result = document.getElementById('knowledgeResult');
  if (result) result.innerHTML = '';
};

// Sembunyikan form tambah artikel
window.hideAddKnowledgeForm = function() {
  const form = document.getElementById('knowledgeForm');
  if (form) form.classList.add('hidden');
  document.getElementById('knowledgeTitle').value = '';
  document.getElementById('knowledgeContent').value = '';
  document.getElementById('knowledgeCategory').value = '';
  document.getElementById('knowledgeFormResult').innerHTML = '';
