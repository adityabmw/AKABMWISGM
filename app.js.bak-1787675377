function render(){
  const cur = location.hash.replace('#','').split('?')[0]||'dashboard';
  document.getElementById('curRoute').innerText = cur.toUpperCase();
  document.querySelectorAll('.nav-route a').forEach(a=>a.classList.toggle('active', a.hash===`#${cur}`));
  try{ Router.routes[cur]?.render?.(); }catch(e){ document.getElementById('app').innerHTML = `<div style="padding:20px"><h2>${cur.toUpperCase()}</h2><p style="color:#ef476f">${e.message}</p><pre>${e.stack||''}</pre></div>`; }
}
window.addEventListener('hashchange', render);
window.addEventListener('DOMContentLoaded', ()=>{ Router.init?.(); render(); });
