# ============================================================
# AKABMW ISGM - Environment Configuration
# ============================================================
# Copy file ini menjadi .env dan isi dengan nilai asli Anda
# JANGAN commit .env ke git!
# ============================================================

# ============ APP CONFIG ============
NODE_ENV=development
PORT=3000
APP_NAME=AKABMW_ISGM
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
TZ=Asia/Jakarta

# ============ FIREBASE ============
# Dapatkan dari Firebase Console → Project Settings → General
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ============ FIREBASE ADMIN SDK (untuk backend) ============
# Download dari Firebase Console → Project Settings → Service accounts
# Simpan sebagai firebase-credentials.json (sudah di .gitignore)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-credentials.json

# ============ AUTHENTICATION ============
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-change-this
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-min-32-characters
BCRYPT_ROUNDS=12

# ============ WHATSAPP INTEGRATION ============
# Fonnte / Wablas / Twilio
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_BUSINESS_NUMBER=6281234567890

# ============ EMAIL (untuk invoice, reminder) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=AKABMW ISGM <noreply@akabmw.id>

# ============ AI / OLLAMA (untuk AVIS) ============
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_TIMEOUT=30000

# ============ BMW ETK DATA ============
ETK_DATA_PATH=./src/data/bmw-etk-data.json
ETK_CACHE_TTL=3600

# ============ FILE STORAGE ============
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# ============ LOGGING ============
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# ============ SECURITY ============
CORS_ORIGIN=http://localhost:3000,https://akabmwisgm.web.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true

# ============ MONITORING ============
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# ============ BUSINESS CONFIG ============
WORKSHOP_NAME=AKABMW Specialist
WORKSHOP_ADDRESS=Jl. Contoh No. 123, Jakarta
WORKSHOP_PHONE=081234567890
WORKSHOP_EMAIL=info@akabmw.id
TAX_RATE=11
CURRENCY=IDR
