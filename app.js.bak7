  if (!name) { alert("⚠️ Nama Vendor Supplier wajib diisi!"); return; }
  const data = {
    name,
    pic: document.getElementById("supplierPIC").value.trim(),
    phone: document.getElementById("supplierPhone").value.trim(),
    whatsapp: document.getElementById("supplierWhatsapp").value.trim(),
