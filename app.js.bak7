// Simpan artikel baru ke Firestore
window.saveKnowledgeArticle = async function() {
  const title = document.getElementById('knowledgeTitle')?.value.trim();
  const content = document.getElementById('knowledgeContent')?.value.trim();
  const category = document.getElementById('knowledgeCategory')?.value.trim();
  const resultDiv = document.getElementById('knowledgeFormResult');

  if (!title || !content) {
    resultDiv.innerHTML = '<p style="color:#f87171;">❌ Judul dan isi wajib diisi!</p>';
    return;
  }

  try {
    await db.collection('knowledge_base').add({
      title,
      content,
      category: category || 'Umum',
      tags: [],
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      createdBy: auth.currentUser?.uid || 'system',
      status: 'PUBLISHED'
    });

    resultDiv.innerHTML = '<p style="color:#4ade80;">✅ Artikel berhasil disimpan!</p>';
    document.getElementById('knowledgeTitle').value = '';
    document.getElementById('knowledgeContent').value = '';
    document.getElementById('knowledgeCategory').value = '';

    // Refresh hasil pencarian (tampilkan semua)
    window.searchKnowledgeUI('');

  } catch (err) {
    resultDiv.innerHTML = `<p style="color:#f87171;">❌ ${err.message}</p>`;
  }
};

// Cari artikel di Knowledge Base
window.searchKnowledgeUI = async function(keyword) {
  const input = document.getElementById('knowledgeSearchInput');
  const searchTerm = keyword || input?.value?.trim() || '';
  const resultDiv = document.getElementById('knowledgeResult');

  if (!searchTerm) {
    // Tampilkan semua artikel
    try {
      const snap = await db.collection('knowledge_base')
        .orderBy('createdAt', 'desc')
        .get();
      const articles = snap.docs.map(d => ({ id: d.id, ...d.data() }));
      renderKnowledgeResults(articles, resultDiv);
    } catch (err) {
      resultDiv.innerHTML = `<p style="color:#f87171;">❌ ${err.message}</p>`;
    }
    return;
  }

  try {
    const snap = await db.collection('knowledge_base').get();
    const articles = snap.docs
      .map(d => ({ id: d.id, ...d.data() }))
      .filter(a =>
        a.title?.toLowerCase().includes(searchTerm.toLowerCase()) ||
        a.content?.toLowerCase().includes(searchTerm.toLowerCase()) ||
        a.category?.toLowerCase().includes(searchTerm.toLowerCase())
      );
    renderKnowledgeResults(articles, resultDiv);
  } catch (err) {
    resultDiv.innerHTML = `<p style="color:#f87171;">❌ ${err.message}</p>`;
  }
};

// Render hasil pencarian Knowledge Base
function renderKnowledgeResults(articles, container) {
  if (!container) return;
  if (!articles || articles.length === 0) {
    container.innerHTML = '<p style="color:#6a7f9a;">📭 Tidak ada artikel ditemukan</p>';
    return;
  }

  let html = `<div style="display:grid;gap:12px;">`;
  articles.forEach(a => {
    const date = a.createdAt?.toDate?.()?.toLocaleDateString() || '-';
    html += `
      <div style="background:#111820;padding:16px;border-radius:12px;border-left:4px solid #1a8cff;">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
          <strong style="color:#e8edf5;">${a.title || 'Tanpa judul'}</strong>
          <span style="font-size:11px;background:#1e2a3a;padding:4px 12px;border-radius:40px;color:#6a7f9a;">${a.category || 'Umum'}</span>
        </div>
        <p style="color:#d0d8e4;font-size:13px;margin-top:8px;">${a.content?.substring(0, 200) || ''}${a.content?.length > 200 ? '...' : ''}</p>
        <div style="display:flex;justify-content:space-between;margin-top:8px;font-size:11px;color:#6a7f9a;">
          <span>📅 ${date}</span>
          <span>🆔 ${a.id?.substring(0, 8) || '-'}</span>
        </div>
      </div>
    `;
  });
  html += `</div>`;
  container.innerHTML = html;
}

console.log('✅ Knowledge Base siap pakai!');

// ============================================================
// KNOWLEDGE BASE — FUNGSI
// ============================================================

// Navigasi ke Knowledge Base
window.showKnowledgePage = function() {
  // Sembunyikan semua view
  document.querySelectorAll('.view-section, .d-none').forEach(el => {
    if (el.id && el.id !== 'knowledgeView') el.classList.add('d-none');
  });
  const view = document.getElementById('knowledgeView');
  if (view) view.classList.remove('d-none');

  // Update active nav
  document.querySelectorAll('.nav-link').forEach(el => el.classList.remove('active'));
  const nav = document.getElementById('navKnowledge');
  if (nav) nav.classList.add('active');

  // Update title
  const title = document.getElementById('viewTitleHeader');
  if (title) title.textContent = '📚 Knowledge Base';

  // Load data
  searchKnowledge();
};

// Tampilkan form tambah
window.showAddKnowledgeForm = function() {
  const form = document.getElementById('kbForm');
  if (form) form.classList.remove('d-none');
};

// Sembunyikan form tambah
window.hideAddKnowledgeForm = function() {
  const form = document.getElementById('kbForm');
  if (form) form.classList.add('d-none');
  document.getElementById('kbTitle').value = '';
  document.getElementById('kbContent').value = '';
  document.getElementById('kbCategory').value = '';
  document.getElementById('kbFormResult').innerHTML = '';
};

// Simpan artikel baru
window.saveKnowledgeArticle = async function() {
  const title = document.getElementById('kbTitle')?.value.trim();
  const content = document.getElementById('kbContent')?.value.trim();
  const category = document.getElementById('kbCategory')?.value.trim();
  const resultDiv = document.getElementById('kbFormResult');

  if (!title || !content) {
    resultDiv.innerHTML = '<div class="alert alert-danger">❌ Judul dan isi wajib diisi!</div>';
    return;
  }

  try {
    await db.collection('knowledge_base').add({
      title,
      content,
      category: category || 'Umum',
      createdAt: firebase.firestore.FieldValue.serverTimestamp(),
      createdBy: auth.currentUser?.uid || 'system',
      status: 'PUBLISHED'
    });

    resultDiv.innerHTML = '<div class="alert alert-success">✅ Artikel berhasil disimpan!</div>';
    document.getElementById('kbTitle').value = '';
    document.getElementById('kbContent').value = '';
    document.getElementById('kbCategory').value = '';
    hideAddKnowledgeForm();
    searchKnowledge();

  } catch (err) {
    resultDiv.innerHTML = `<div class="alert alert-danger">❌ ${err.message}</div>`;
  }
};

// Cari artikel
window.searchKnowledge = async function() {
  const keyword = document.getElementById('kbSearch')?.value.trim();
  const resultDiv = document.getElementById('kbResult');
  if (!resultDiv) return;

  try {
    let query = db.collection('knowledge_base').orderBy('createdAt', 'desc');
    const snap = await query.get();
    let articles = snap.docs.map(d => ({ id: d.id, ...d.data() }));

    if (keyword) {
      articles = articles.filter(a =>
        a.title?.toLowerCase().includes(keyword.toLowerCase()) ||
        a.content?.toLowerCase().includes(keyword.toLowerCase()) ||
        a.category?.toLowerCase().includes(keyword.toLowerCase())
      );
    }

    if (articles.length === 0) {
      resultDiv.innerHTML = '<div class="alert alert-secondary text-center">📭 Tidak ada artikel ditemukan</div>';
      return;
    }

    let html = '<div class="row g-3">';
    articles.forEach(a => {
      const date = a.createdAt?.toDate?.()?.toLocaleDateString('id-ID') || '-';
      html += `
        <div class="col-12">
          <div class="card-glow p-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap">
              <h5 class="fw-bold text-white">${a.title || 'Tanpa judul'}</h5>
              <span class="badge bg-secondary">${a.category || 'Umum'}</span>
            </div>
            <p class="text-secondary mt-2">${a.content?.substring(0, 250) || ''}${a.content?.length > 250 ? '...' : ''}</p>
            <small class="text-muted">📅 ${date} · 🆔 ${a.id?.substring(0, 8) || '-'}</small>
          </div>
        </div>
      `;
    });
    html += '</div>';
    resultDiv.innerHTML = html;

  } catch (err) {
    resultDiv.innerHTML = `<div class="alert alert-danger">❌ ${err.message}</div>`;
  }
};

console.log('✅ Knowledge Base terintegrasi!');
