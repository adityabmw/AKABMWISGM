{
  "name": "aka-bmw-isgm",
  "version": "5.0.0",
  "description": "AKA BMW ISGM — Integrated System Gateway Management",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && firebase deploy --only hosting",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "functions:serve": "cd functions && npm run serve",
    "functions:deploy": "cd functions && npm run deploy",
    "seed": "node scripts/seed.js",
    "test": "vitest",
    "lint": "eslint js/**/*.js",
    "format": "prettier --write js/**/*.js",
    "analyze": "vite-bundle-visualizer",
    "sprint": "bash scripts/sprint-audit.sh"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "firebase": "^10.12.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "vite": "^8.1.4",
    "vite-bundle-visualizer": "^1.0.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "bmw",
    "dealer-management",
    "workshop",
    "firebase",
    "pwa",
    "isgm"
  ],
  "author": "AKA BMW ISGM Team",
  "license": "UNLICENSED",
  "private": true
}