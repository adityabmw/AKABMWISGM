const db = getFirestore(app);

// ========================== UTILITY UTILS ==========================
function formatRupiah(amount) {
  return "Rp " + Number(amount || 0).toLocaleString("id-ID");
}

// ========================== CORE VARIABLES ==========================
let poItems = [];
let localLaborItems = [];
let localPartItems = [];
let revenueChartInstance = null;
let woStatusChartInstance = null;

const loading = document.getElementById("loadingScreen");
const authPage = document.getElementById("authPage");
const dashboardPage = document.getElementById("dashboardPage");
const btnLogin = document.getElementById("btnLogin");
const btnLogout = document.getElementById("btnLogout");
const btnRegister = document.getElementById("btnRegister");

if (loading) loading.style.display = "none";

// ========================== SYSTEM AUTHENTICATION ==========================
if (btnLogin) {
  btnLogin.addEventListener("click", async function() {
    const role = document.getElementById("loginRole").value;
    const email = document.getElementById("loginEmail").value.trim();
    const password = document.getElementById("loginPassword").value;
    if (!role || !email || !password) {
      alert("⚠️ Mohon lengkapi semua isian data login!");
      return;
    }
    if (loading) loading.style.display = "flex";
    try {
      const userCred = await signInWithEmailAndPassword(auth, email, password);
      const userDoc = await getDoc(doc(db, "users", userCred.user.uid));
      if (!userDoc.exists()) {
        await signOut(auth);
        alert("❌ Akun Anda belum terdaftar pada master records system database!");
        if (loading) loading.style.display = "none";
        return;
      }
      const userData = userDoc.data();
      const currentRole = userData.Role || userData.role || "";
      if (currentRole !== role) {
        await signOut(auth);
        alert("⛔ Akses Ditolak! Alokasi koordinasi hak akses Role Anda salah.");
        if (loading) loading.style.display = "none";
        return;
      }
      await updateDoc(doc(db, "users", userCred.user.uid), { lastLogin: new Date().toISOString() });
      alert("✅ Selamat Datang Kembali!");
    } catch (e) {
      alert("❌ Kegagalan Proses Otentikasi: " + e.message);
    } finally {
      if (loading) loading.style.display = "none";
    }
  });
}

if (btnRegister) {
  btnRegister.addEventListener("click", async function() {
    const name = document.getElementById("registerName").value.trim();
    const email = document.getElementById("registerEmail").value.trim();
    const password = document.getElementById("registerPassword").value;
    const role = document.getElementById("registerRole").value;
    if (!name || !email || !password) {
      alert("⚠️ Semua kolom wajib diisi lengkap!");
      return;
    }
    if (password.length < 6) {
      alert("⚠️ Kriteria password minimal harus berisi 6 karakter!");
      return;
    }
    if (loading) loading.style.display = "flex";
    try {
      let status = "PENDING";
      if (role === "OWNER") {
        const q = query(collection(db, "users"), where("Role", "==", "OWNER"), where("status", "==", "ACTIVE"));
        const snap = await getDocs(q);
        if (snap.empty) status = "ACTIVE";
      }
      const userCred = await createUserWithEmailAndPassword(auth, email, password);
      await setDoc(doc(db, "users", userCred.user.uid), {
        Name: name,
        Email: email,
        Role: role,
        status: status,
        createdAt: new Date().toISOString()
      });
      alert("✅ Registrasi berhasil! " + (status === "ACTIVE" ? "Akun OWNER Anda otomatis aktif." : "Mohon tunggu proses ACC verifikasi data oleh OWNER / ADMIN."));
      document.getElementById("registerName").value = "";
      document.getElementById("registerEmail").value = "";
      document.getElementById("registerPassword").value = "";
      const modalElement = document.getElementById("registerModal");
      const modal = bootstrap.Modal.getInstance(modalElement) || new bootstrap.Modal(modalElement);
      if (modal) modal.hide();
    } catch (e) {
      alert("❌ Registrasi Gagal: " + e.message);
    } finally {
      if (loading) loading.style.display = "none";
    }
  });
}

if (btnLogout) {
  btnLogout.addEventListener("click", function() {
    if(confirm("Apakah Anda yakin ingin keluar dari sistem AKA BMW ISGM?")) {
      signOut(auth);
    }
  });
}

// ========================== ROUTING NAVIGATION ==========================
function resetPages() {
  const ids = [
    "dashboardView","receptionView","workOrderView","customerView","vehicleView",
    "inventoryView","supplierView","purchaseOrderView","estimationView","invoiceView",
    "cashierView","reportView","activityLogView","userView","settingsView",
    "bmwEtkView","wiringDiagramView","whatsappCenterView"
  ];
  ids.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.add("d-none");
  });
}

function setActiveNav(id) {
  const ids = ["navDash","navRec","navWO","navCust","navVehicle","navParts","navPO","navSupplier","navKasir","navUser","navSettings","navBmwEtk","navWiring","navWhatsapp","navEstimation","navInvoice","navReport","navActivity"];
  ids.forEach(navId => {
    const el = document.getElementById(navId);
    if (el) {
      if (navId === id) el.classList.add("active");
      else el.classList.remove("active");
    }
  });
}

window.showDashboardView = function() { resetPages(); setActiveNav("navDash"); document.getElementById("dashboardView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Dashboard Overview"; };
window.showReceptionPage = function() { resetPages(); setActiveNav("navRec"); document.getElementById("receptionView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Reception & Check In"; generateCheckinNumber(); };
window.showWOPage = function() { resetPages(); setActiveNav("navWO"); document.getElementById("workOrderView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Work Order Management"; generateWONumber(); };
window.showCustomerPage = function() { resetPages(); setActiveNav("navCust"); document.getElementById("customerView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Customer Master Database"; };
window.showVehiclePage = function() { resetPages(); setActiveNav("navVehicle"); document.getElementById("vehicleView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Vehicle Records System"; };
window.showInventoryPage = function() { resetPages(); setActiveNav("navParts"); document.getElementById("inventoryView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Inventory Stock Management"; };
window.showSupplierPage = function() { resetPages(); setActiveNav("navSupplier"); document.getElementById("supplierView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Supplier Vendor Records"; };
window.showPOPage = function() { resetPages(); setActiveNav("navPO"); document.getElementById("purchaseOrderView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Purchase Order Procurement"; generatePONumber(); };
window.showEstimationPage = function() { resetPages(); setActiveNav("navEstimation"); document.getElementById("estimationView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Estimation Penawaran Biaya"; generateEstimationNumber(); };
window.showInvoicePage = function() { resetPages(); setActiveNav("navInvoice"); document.getElementById("invoiceView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Invoice Billing Terminal"; generateInvoiceNumber(); };
window.showCashierPage = function() { resetPages(); setActiveNav("navKasir"); document.getElementById("cashierView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Cashier Point Of Payments"; generatePaymentNumber(); };
window.showReportPage = function() { resetPages(); setActiveNav("navReport"); document.getElementById("reportView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Business Intelligence Report"; };
window.showActivityLogPage = function() { resetPages(); setActiveNav("navActivity"); document.getElementById("activityLogView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="System Log Activity"; };
window.showUserManagement = function() { resetPages(); setActiveNav("navUser"); document.getElementById("userView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="System Access & User Management"; loadUserTable(); };
window.showSettingsPage = function() { resetPages(); setActiveNav("navSettings"); document.getElementById("settingsView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="Global Workshop Settings"; };
window.showBMWETK = function() { resetPages(); setActiveNav("navBmwEtk"); document.getElementById("bmwEtkView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="BMW Electronic Parts Catalog"; };
window.showWiringDiagram = function() { resetPages(); setActiveNav("navWiring"); document.getElementById("wiringDiagramView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="BMW Wiring Diagrams Library"; };
window.showWhatsAppCenter = function() { resetPages(); setActiveNav("navWhatsapp"); document.getElementById("whatsappCenterView")?.classList.remove("d-none"); document.getElementById("viewTitleHeader").innerText="WhatsApp Notification Gateway"; };

// ========================== CORE DATA REALTIME MONITOR SINKRONISASI ==========================
onAuthStateChanged(auth, async function(user) {
  if (loading) loading.style.display = "none";
  if (user) {
    try {
      const userDoc = await getDoc(doc(db, "users", user.uid));
      if (!userDoc.exists()) { await signOut(auth); return; }
      const d = userDoc.data();
      if ((d.status || "PENDING") !== "ACTIVE") { await signOut(auth); alert("⚠️ Status akun Anda ditangguhkan/belum aktif!"); return; }
      
      const userBadge = document.getElementById("currentUser");
      if (userBadge) userBadge.innerText = "USER: " + (d.Name || "Karyawan") + " (" + (d.Role || "STAFF") + ")";
      
      if (authPage) authPage.classList.add("d-none");
      if (dashboardPage) dashboardPage.classList.remove("d-none");

      onSnapshot(collection(db, "customers"), function(snap) {
        renderCustomers(snap);
        updateCustomerDropdowns(snap);
        updateWACustomerDropdown(snap);
        renderWACustomerList(snap);
      });

      onSnapshot(collection(db, "vehicles"), function(snap) {
        renderVehicles(snap);
        updateVehicleDropdown(snap);
      });

      onSnapshot(collection(db, "workorders"), function(snap) {
        renderWorkOrders(snap);
        renderWOTableDashboard(snap);
        updateWOKPI(snap);
        updateWODropdowns(snap);
      });

      onSnapshot(collection(db, "checkins"), function(snap) {
        renderCheckinTable(snap);
      });

      onSnapshot(collection(db, "parts"), function(snap) {
        renderInventory(snap);
        checkLowStock(snap);
        updatePartDropdown(snap);
      });

      onSnapshot(collection(db, "suppliers"), function(snap) {
        renderSuppliers(snap);
        updateSupplierDropdown(snap);
      });

      onSnapshot(collection(db, "purchaseorders"), function(snap) {
        renderPurchaseOrders(snap);
      });

      onSnapshot(collection(db, "estimations"), function(snap) {
        renderEstimations(snap);
      });

      onSnapshot(collection(db, "invoices"), function(snap) {
        renderInvoices(snap);
        updateInvoiceDropdown(snap);
      });

      onSnapshot(collection(db, "payments"), function(snap) {
        renderPayments(snap);
      });

      onSnapshot(collection(db, "activitylogs"), function(snap) {
        renderActivityLogs(snap);
      });

    } catch (e) {
      console.error("Critical State Sync Error:", e);
    }
  } else {
    if (authPage) authPage.classList.remove("d-none");
    if (dashboardPage) dashboardPage.classList.add("d-none");
  }
});

// ========================== MODULE CUSTOMER ==========================
function renderCustomers(snap) {
  const tbody = document.getElementById("customerTable");
  if (!tbody) return;
  if (snap.empty) { tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">Belum ada basis data pelanggan.</td></tr>'; return; }
  let html = "";
  snap.forEach(doc => {
    const d = doc.data();
    html += `<tr><td><strong>${d.name||'-'}</strong></td><td>${d.phone||'-'}</td><td>${d.email||'-'}</td><td>${d.city||'-'}</td><td>${d.address||'-'}</td><td><button class="btn btn-sm btn-outline-danger" onclick="deleteCustomerData('${doc.id}')">Hapus</button></td></tr>`;
  });
  tbody.innerHTML = html;
}

function updateCustomerDropdowns(snap) {
  const ids = ["checkinCustomer","woCustomer","vehicleCustomer"];
  ids.forEach(id => {
    const sel = document.getElementById(id);
    if (!sel) return;
    const val = sel.value;
    sel.innerHTML = '<option value="">Pilih Customer</option>';
    snap.forEach(doc => {
      const d = doc.data();
      const opt = document.createElement("option");
      opt.value = doc.id;
      opt.dataset.name = d.name || "";
      opt.textContent = d.name || "";
      sel.appendChild(opt);
    });
    sel.value = val;
  });
}

document.getElementById("btnAddCustomer")?.addEventListener("click", async function() {
  const name = document.getElementById("customerName").value.trim();
  const phone = document.getElementById("customerPhone").value.trim();
  if (!name || !phone) { alert("⚠️ Field Nama Pelanggan & No WA wajib diisikan!"); return; }
  const data = {
    name: name, phone: phone,
    email: document.getElementById("customerEmail").value.trim(),
    address: document.getElementById("customerAddress").value.trim(),
    city: document.getElementById("customerCity").value.trim(),
    birthDate: document.getElementById("customerBirthDate").value,
    note: document.getElementById("customerNote").value.trim(),
    createdAt: new Date().toISOString()
  };
  await addDoc(collection(db, "customers"), data);
  alert("✅ Sukses menambahkan data master customer!");
  ["customerName","customerPhone","customerEmail","customerAddress","customerCity","customerBirthDate","customerNote"].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = "";
  });
  logActivity('CUSTOMER','Add Data','Customer: ' + name);
});

window.deleteCustomerData = async function(id) {
  if(confirm("Apakah Anda yakin ingin menghapus data customer ini?")) {
    await deleteDoc(doc(db, "customers", id));
    logActivity('CUSTOMER','Delete Data','ID: ' + id);
  }
};

// ========================== MODULE VEHICLE ==========================
function renderVehicles(snap) {
  const tbody = document.getElementById("vehicleTable");
  if (!tbody) return;
  if (snap.empty) { tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Belum ada unit terdaftar.</td></tr>'; return; }
  let html = "";
  snap.forEach(doc => {
    const d = doc.data();
    html += `<tr><td><span class="badge bg-dark text-info border border-info">${d.plate||'-'}</span></td><td>${d.model||'-'} (${d.series||'-'})</td><td>${d.vin||'-'}</td><td>${d.ownerName||'-'}</td><td>${Number(d.km).toLocaleString('id-ID')} KM</td><td>${d.transmission||'-'}</td><td><button class="btn btn-sm btn-outline-danger" onclick="deleteVehicleData('${doc.id}')">Hapus</button></td></tr>`;
  });
  tbody.innerHTML = html;
}

function updateVehicleDropdown(snap) {
  const sel = document.getElementById("woVehicle");
  if (!sel) return;
  const val = sel.value;
  sel.innerHTML = '<option value="">Pilih Kendaraan</option>';
  snap.forEach(doc => {
    const d = doc.data();
    const opt = document.createElement("option");
    opt.value = doc.id;
    opt.dataset.plate = d.plate || "";
    opt.textContent = `${d.plate} - ${d.model} (${d.ownerName})`;
    sel.appendChild(opt);
  });
  sel.value = val;
}

document.getElementById("btnAddVehicle")?.addEventListener("click", async function() {
  const customerSel = document.getElementById("vehicleCustomer");
  const model = document.getElementById("vehicleModel").value.trim();
  const vin = document.getElementById("vehicleVin").value.trim().toUpperCase();
  const plate = document.getElementById("vehiclePlate").value.trim().toUpperCase();
  const km = parseFloat(document.getElementById("vehicleKm").value) || 0;
  if (!customerSel.value || !model || !vin || !plate) { alert("⚠️ Harap lengkapi isian data sasis unit mobil!"); return; }
  
  const ownerName = customerSel.options[customerSel.selectedIndex].dataset.name || "Unknown";
  const data = {
    ownerId: customerSel.value, ownerName: ownerName,
    model: model, vin: vin, plate: plate, km: km,
    series: document.getElementById("vehicleSeries").value.trim(),
    year: document.getElementById("vehicleYear").value.trim(),
    color: document.getElementById("vehicleColor").value.trim(),
    engine: document.getElementById("vehicleEngine").value.trim(),
    transmission: document.getElementById("vehicleTransmission").value,
    createdAt: new Date().toISOString()
  };
  await addDoc(collection(db, "vehicles"), data);
  alert("✅ Unit mobil baru berhasil diverifikasi ke database master!");
  ["vehicleModel","vehicleVin","vehiclePlate","vehicleKm","vehicleSeries","vehicleYear","vehicleColor","vehicleEngine"].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = "";
  });
  logActivity('VEHICLE','Add Vehicle','Nopol: ' + plate);
});

window.deleteVehicleData = async function(id) {
  if (confirm("Hapus rekam data sasis unit ini?")) {
    await deleteDoc(doc(db, "vehicles", id));
    logActivity('VEHICLE', 'Delete Data', 'ID: ' + id);
  }
};

// ========================== MODULE RECEPTION (CHECK IN) ==========================
function generateCheckinNumber() { const el = document.getElementById("checkinNumber"); if (el) el.value = "CI-" + Date.now().toString().slice(-6); }

document.getElementById("btnCheckIn")?.addEventListener("click", async function() {
  const custSel = document.getElementById("checkinCustomer");
  const plate = document.getElementById("checkinPlate").value.trim().toUpperCase();
  const km = parseFloat(document.getElementById("checkinKm").value) || 0;
  if (!custSel.value || !plate) { alert("⚠️ Pastikan Customer & Nomor Polisi valid!"); return; }
  
  const customerName = custSel.options[custSel.selectedIndex].dataset.name || "Unknown";
  const data = {
    checkinNo: document.getElementById("checkinNumber").value,
    customerId: custSel.value, customerName: customerName,
    plate: plate,
    vin: document.getElementById("checkinVin").value.trim().toUpperCase(),
    model: document.getElementById("checkinModel").value.trim(),
    km: km,
    fuel: document.getElementById("checkinFuel").value,
    complaint: document.getElementById("checkinComplaint").value.trim(),
    note: document.getElementById("checkinNote").value.trim(),
    bodyCheck: document.getElementById("bodyCheck").checked,
    lampCheck: document.getElementById("lampCheck").checked,
    glassCheck: document.getElementById("glassCheck").checked,
    tireCheck: document.getElementById("tireCheck").checked,
    interiorCheck: document.getElementById("interiorCheck").checked,
    toolkitCheck: document.getElementById("toolkitCheck").checked,
    photoMetadata: document.getElementById("checkinPhoto").value,
    status: "CHECK_IN",
    createdAt: new Date().toISOString()
  };
  await addDoc(collection(db, "checkins"), data);
  alert("✅ Kendaraan masuk berhasil diregistrasi!");
  ["checkinPlate","checkinVin","checkinModel","checkinKm","checkinComplaint","checkinNote","checkinPhoto"].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = "";
  });
  ["bodyCheck","lampCheck","glassCheck","tireCheck","interiorCheck","toolkitCheck"].forEach(id => {
    const el = document.getElementById(id); if (el) el.checked = false;
  });
  generateCheckinNumber();
  logActivity('CHECKIN','Execute Checkin','No: ' + data.checkinNo);
});

document.getElementById("btnResetCheckIn")?.addEventListener("click", function() {
  if (confirm("Reset isian form registrasi check-in?")) {
    ["checkinPlate","checkinVin","checkinModel","checkinKm","checkinComplaint","checkinNote","checkinPhoto"].forEach(id => {
      const el = document.getElementById(id); if (el) el.value = "";
    });
    generateCheckinNumber();
  }
});

function renderCheckinTable(snap) {
  const tbody = document.getElementById("recentCheckinList");
  if (!tbody) return;
  if (snap.empty) { tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Belum ada unit masuk workshop hari ini.</td></tr>'; return; }
  let html = "";
  snap.forEach(doc => {
    const d = doc.data();
    html += `<tr><td><span class="badge bg-secondary">${d.checkinNo}</span></td><td>${d.customerName}</td><td>${d.plate}</td><td>${d.model || '-'}</td><td>${Number(d.km).toLocaleString('id-ID')} KM</td><td>${d.complaint || '-'}</td><td>${d.createdAt ? d.createdAt.substring(0,10) : '-'}</td></tr>`;
  });
  tbody.innerHTML = html;
}

// ========================== MODULE WORK ORDER ==========================
function generateWONumber() { const el = document.getElementById("woNumber"); if (el) el.value = "WO-" + Date.now().toString().slice(-6); }

document.getElementById("btnAddLabor")?.addEventListener("click", function() {
  const desc = document.getElementById("laborDescription").value.trim();
  const qty = parseFloat(document.getElementById("laborQty").value) || 0;
  const price = parseFloat(document.getElementById("laborPrice").value) || 0;
  if (!desc || qty <= 0 || price <= 0) { alert("⚠️ Masukkan data jasa labor dengan benar!"); return; }
  localLaborItems.push({ desc, qty, price, total: qty * price });
  renderLocalLaborTable();
  calculateLocalWOTotals();
});

function renderLocalLaborTable() {
  const div = document.getElementById("laborTable");
  if (!div) return;
  if (localLaborItems.length === 0) { div.innerHTML = ""; return; }
  let html = '<table class="table table-sm table-bordered border-secondary small"><thead><tr><th>Deskripsi Jasa</th><th>Qty</th><th>Harga</th><th>Subtotal</th><th>Aksi</th></tr></thead><tbody>';
  localLaborItems.forEach((item, idx) => {
    html += `<tr><td>${item.desc}</td><td>${item.qty}</td><td>${formatRupiah(item.price)}</td><td>${formatRupiah(item.total)}</td><td><button class="btn btn-sm btn-danger py-0" onclick="removeLocalLabor(${idx})">x</button></td></tr>`;
  });
  html += '</tbody></table>';
  div.innerHTML = html;
}

window.removeLocalLabor = function(idx) { localLaborItems.splice(idx,1); renderLocalLaborTable(); calculateLocalWOTotals(); };

document.getElementById("btnAddPartWO")?.addEventListener("click", async function() {
  const partSel = document.getElementById("woPart");
  const qty = parseInt(document.getElementById("woPartQty").value) || 0;
  const price = parseFloat(document.getElementById("woPartPrice").value) || 0;
  if (!partSel.value || qty <= 0 || price <= 0) { alert("⚠️ Isikan penambahan sparepart secara logis!"); return; }
  
  const partDoc = await getDoc(doc(db, "parts", partSel.value));
  if (!partDoc.exists()) return;
  const pData = partDoc.data();
  localPartItems.push({ partId: partSel.value, partNumber: pData.partNumber, partName: pData.partName, qty, price, total: qty * price });
  renderLocalPartsTable();
  calculateLocalWOTotals();
});

function renderLocalPartsTable() {
  const div = document.getElementById("woPartsTable");
  if (!div) return;
  if (localPartItems.length === 0) { div.innerHTML = ""; return; }
  let html = '<table class="table table-sm table-bordered border-secondary small"><thead><tr><th>Part Number / Name</th><th>Qty</th><th>Harga Jual</th><th>Subtotal</th><th>Aksi</th></tr></thead><tbody>';
  localPartItems.forEach((item, idx) => {
    html += `<tr><td>${item.partNumber} - ${item.partName}</td><td>${item.qty}</td><td>${formatRupiah(item.price)}</td><td>${formatRupiah(item.total)}</td><td><button class="btn btn-sm btn-danger py-0" onclick="removeLocalPart(${idx})">x</button></td></tr>`;
  });
  html += '</tbody></table>';
  div.innerHTML = html;
}

window.removeLocalPart = function(idx) { localPartItems.splice(idx,1); renderLocalPartsTable(); calculateLocalWOTotals(); };

function calculateLocalWOTotals() {
  let totalLabor = localLaborItems.reduce((acc, item) => acc + item.total, 0);
  let totalParts = localPartItems.reduce((acc, item) => acc + item.total, 0);
  document.getElementById("totalLabor").innerText = formatRupiah(totalLabor);
  document.getElementById("totalParts").innerText = formatRupiah(totalParts);
  document.getElementById("grandTotal").innerText = formatRupiah(totalLabor + totalParts);
}

document.getElementById("btnCreateWO")?.addEventListener("click", async function() {
  const custSel = document.getElementById("woCustomer");
  const vSel = document.getElementById("woVehicle");
  const sa = document.getElementById("woServiceAdvisor").value.trim();
  if (!custSel.value || !vSel.value || !sa) { alert("⚠️ Customer, Vehicle, & SA wajib ditentukan!"); return; }
  
  const totalLabor = localLaborItems.reduce((acc, item) => acc + item.total, 0);
  const totalParts = localPartItems.reduce((acc, item) => acc + item.total, 0);
  const grandTotal = totalLabor + totalParts;
  
  const data = {
    woNumber: document.getElementById("woNumber").value,
    woDate: document.getElementById("woDate").value,
    customerId: custSel.value, customerName: custSel.options[custSel.selectedIndex].dataset.name,
    vehicleId: vSel.value, vehiclePlate: vSel.options[vSel.selectedIndex].dataset.plate,
    sa: sa,
    foreman: document.getElementById("woForeman").value.trim(),
    technician: document.getElementById("woTechnician").value.trim(),
    complaint: document.getElementById("woComplaint").value.trim(),
    diagnosis: document.getElementById("woDiagnosis").value.trim(),
    labors: localLaborItems,
    parts: localPartItems,
    totalLabor, totalParts, grandTotal,
    status: document.getElementById("woStatus").value,
    progress: parseInt(document.getElementById("woProgressRange").value) || 0,
    createdAt: new Date().toISOString()
  };
  
  await addDoc(collection(db, "workorders"), data);
  alert("✅ Lembar Work Order Resmi berhasil diaktifkan!");
  
  for (let p of localPartItems) {
    const pRef = doc(db, "parts", p.partId);
    const pSnap = await getDoc(pRef);
    if (pSnap.exists()) {
      let oldStock = parseInt(pSnap.data().stock) || 0;
      await updateDoc(pRef, { stock: Math.max(0, oldStock - p.qty) });
    }
  }
  
  localLaborItems = []; localPartItems = [];
  renderLocalLaborTable(); renderLocalPartsTable(); calculateLocalWOTotals();
  ["woServiceAdvisor","woForeman","woTechnician","woComplaint","woDiagnosis","woProgressRange"].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = (id==="woProgressRange"? "0": "");
  });
  generateWONumber();
  logActivity('WORKORDER','Create WO','No: ' + data.woNumber);
});

function renderWorkOrders(snap) {
  const tbody = document.getElementById("workOrderTable");
  if (!tbody) return;
  if (snap.empty) { tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">Tidak ada arsip dokumen Work Order.</td></tr>'; return; }
  let html = "";
  snap.forEach(doc => {
    const d = doc.data();
    html += `<tr>
      <td><span class="badge bg-dark text-info">${d.woNumber}</span></td>
      <td>${d.customerName || '-'}</td>
      <td>${d.vehiclePlate || '-'}</td>
      <td>${d.sa || '-'}</td>
      <td><span class="badge bg-info">${d.status}</span></td>
      <td>${d.progress || 0}%</td>
      <td>${formatRupiah(d.grandTotal)}</td>
      <td><button class="btn btn-sm btn-outline-danger" onclick="deleteWO('${doc.id}')">Hapus</button></td>
    </tr>`;
  });
  tbody.innerHTML = html;
}

window.deleteWO = async function(id) {
  if (confirm("Hapus rekam data Work Order ini?")) {
    await deleteDoc(doc(db, "workorders", id));
    logActivity('WORKORDER', 'Delete WO', 'ID: ' + id);
  }
};

function updateWODropdowns(snap) {
  const ids = ["estimationWO","invoiceWO"];
  ids.forEach(id => {
    const sel = document.getElementById(id);
    if (!sel) return;
    const val = sel.value;
    sel.innerHTML = '<option value="">Pilih WO Referensi</option>';
    snap.forEach(doc => {
      const d = doc.data();
      const opt = document.createElement("option");
      opt.value = doc.id;
      opt.dataset.wonumber = d.woNumber;
      opt.dataset.custname = d.customerName;
      opt.dataset.total = d.grandTotal || 0;
      opt.textContent = `${d.woNumber} - ${d.customerName} (${formatRupiah(d.grandTotal)})`;
      sel.appendChild(opt);
    });
    sel.value = val;
  });
}

document.getElementById("estimationWO")?.addEventListener("change", function() {
  const customerInput = document.getElementById("estimationCustomer");
  if (!customerInput) return;
  if (!this.value) { customerInput.value = ""; return; }
  const opt = this.options[this.selectedIndex];
  customerInput.value = opt.dataset.custname || "";
  document.getElementById("estimationLabor").value = opt.dataset.total;
  calculateEstimationValues();
});

document.getElementById("invoiceWO")?.addEventListener("change", function() {
  const customerInput = document.getElementById("invoiceCustomer");
  if (!customerInput) return;
  if (!this.value) { customerInput.value = ""; return; }
  const opt = this.options[this.selectedIndex];
  customerInput.value = opt.dataset.custname || "";
  document.getElementById("invoiceSubtotal").value = opt.dataset.total;
  calculateInvoiceValues();
});

// ========================== DASHBOARD LIVE MONITOR ==========================
function renderWOTableDashboard(snap) {
  const tbody = document.getElementById("woTableBody");
  if (!tbody) return;
  let html = "", no = 1;
  snap.forEach(doc => {
    const d = doc.data();
    html += `<tr>
      <td>${no++}</td>
      <td><span class="badge bg-dark text-info">${d.woNumber}</span></td>
      <td>${d.customerName} / <span class="text-warning">${d.vehiclePlate}</span></td>
      <td><span class="badge bg-secondary">${d.status}</span></td>
      <td><div class="progress" style="height:6px; background:#1f2a3f;"><div class="progress-bar bg-success" style="width:${d.progress || 0}%;"></div></div></td>
      <td>${d.technician || d.sa || '-'}</td>
    </tr>`;
  });
  if (!html) html = '<tr><td colspan="6" class="text-center text-muted">Belum ada antrean unit hari ini.</td></tr>';
  tbody.innerHTML = html;
}

function updateWOKPI(snap) {
  document.getElementById("totalWO").innerText = snap.size;
  let running = 0;
  snap.forEach(doc => { if (doc.data().status === "PROSES") running++; });
  document.getElementById("liveProcess").innerText = running;
}

// ========================== MODULE INVENTORY ==========================
function renderInventory(snap) {
  const tbody = document.getElementById("inventoryTable");
  if (!tbody) return;
  if (snap.empty) { tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">Gudang kosong.</td></tr>'; return; }
  let html = "";
  snap.forEach(doc => {
    const d = doc.data();
    const isLow = (parseInt(d.stock) || 0) <= (parseInt(d.minStock) || 0);
    html += `<tr class="${isLow ? 'table-danger text-dark':''}">
      <td><span class="badge bg-dark text-info">${d.partNumber}</span></td>
      <td><strong>${d.partName}</strong></td>
      <td>${d.brand || '-'}</td>
      <td>${d.stock} unit</td>
      <td>${d.minStock} unit</td>
      <td>${formatRupiah(d.costPrice)}</td>
      <td>${formatRupiah(d.sellPrice)}</td>
      <td><button class="btn btn-sm btn-danger py-0" onclick="deletePart('${doc.id}')">Hapus</button></td>
    </tr>`;
  });
  tbody.innerHTML = html;
}

function checkLowStock(snap) {
  const container = document.getElementById("lowStockInventory");
  if (!container) return;
  let items = [], lowCount = 0;
  snap.forEach(doc => {
    const d = doc.data();
    const stock = parseInt(d.stock) || 0;
    const min = parseInt(d.minStock) || 0;
    if (stock <= min) {
      lowCount++;
      items.push(`${d.partName} (Sisa: ${stock} unit)`);
    }
  });
  document.getElementById("cardWaitingParts").innerText = lowCount;
  if (items.length === 0) {
    container.innerHTML = "✅ Stok logistik aman terkendali.";
    container.className = "text-success small";
  } else {
    container.innerHTML = "⚠️ Kritis Re-Order: " + items.join(", ");
    container.className = "text-danger small fw-bold";
  }
}

function updatePartDropdown(snap) {
  const ids = ["woPart","poPart"];
  ids.forEach(id => {
    const sel = document.getElementById(id);
    if (!sel) return;
    const val = sel.value;
    sel.innerHTML = '<option value="">Pilih Sparepart</option>';
    snap.forEach(doc => {
      const d = doc.data();
      const opt = document.createElement("option");
      opt.value = doc.id;
      opt.textContent = `${d.partNumber} - ${d.partName} (Stok: ${d.stock})`;
      sel.appendChild(opt);
    });
    sel.value = val;
  });
}

document.getElementById("btnAddInventory")?.addEventListener("click", async function() {
  const partNumber = document.getElementById("partNumber").value.trim();
  const partName = document.getElementById("partName").value.trim();
  if (!partNumber || !partName) { alert("⚠️ Part Number & Deskripsi wajib diisi!"); return; }
  
  const data = {
    partNumber, partName,
    brand: document.getElementById("partBrand").value.trim(),
    category: document.getElementById("partCategory").value,
    supplierId: document.getElementById("partSupplier").value,
    stock: parseInt(document.getElementById("partStock").value) || 0,
    minStock: parseInt(document.getElementById("partMinStock").value) || 0,
    costPrice: parseFloat(document.getElementById("partCostPrice").value) || 0,
    sellPrice: parseFloat(document.getElementById("partSellPrice").value) || 0,
    barcode: document.getElementById("partBarcode").value.trim(),
    createdAt: new Date().toISOString()
  };
  await addDoc(collection(db, "parts"), data);
  alert("✅ Master Item Suku Cadang Ditambahkan!");
  ["partNumber","partName","partBrand","partStock","partMinStock","partCostPrice","partSellPrice","partBarcode"].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = (id.includes("Price") || id.includes("Stock") ? "0" : "");
  });
  logActivity('INVENTORY','Add Item','Part: ' + partNumber);
});

window.deletePart = async function(id) {
  if (confirm("Hapus item dari gudang logistik?")) {
    await deleteDoc(doc(db, "parts", id));
    logActivity('INVENTORY', 'Delete Item', 'ID: ' + id);
  }
};

