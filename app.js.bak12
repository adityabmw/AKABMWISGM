// ============================================================
// 8. KNOWLEDGE BASE — FUNGSI
// ============================================================
window.showKnowledgePage = function() {
  document.querySelectorAll('.view-section, .d-none').forEach(el => {
    if (el.id && el.id !== 'knowledgeView') {
      el.classList.add('d-none');
    }
  });
  const page = document.getElementById('knowledgeView');
  if (page) page.classList.remove('d-none');
  document.querySelectorAll('.nav-link').forEach(el => el.classList.remove('active'));
  const nav = document.getElementById('navKnowledge');
  if (nav) nav.classList.add('active');
  const title = document.getElementById('viewTitleHeader');
  if (title) title.textContent = '📚 Knowledge Base BMW';
  const resultDiv = document.getElementById('kbResultContainer');
  if (resultDiv) {
    resultDiv.innerHTML = `
      <div class="text-center text-secondary p-4">
        <i class="fa-solid fa-book-open fa-3x mb-3"></i>
        <p>Masukkan kata kunci teknis BMW</p>
        <small>Contoh: N20, E46, 2C58, torque, timing chain, vanos</small>
      </div>
    `;
  }
};

window.searchBMWKnowledge = function() {
  const keyword = document.getElementById('kbSearchInput')?.value.trim().toLowerCase();
  const resultDiv = document.getElementById('kbResultContainer');
  if (!resultDiv) return;

  if (!keyword) {
    resultDiv.innerHTML = `<div class="alert alert-warning">⚠️ Masukkan kata kunci teknis BMW</div>`;
    return;
  }

  const results = BMW_KNOWLEDGE_DATA.filter(item => {
    return item.keywords.some(k => k.includes(keyword)) ||
           item.title.toLowerCase().includes(keyword) ||
           item.category.toLowerCase().includes(keyword) ||
           item.content.toLowerCase().includes(keyword);
  });

  if (results.length === 0) {
    resultDiv.innerHTML = `
      <div class="alert alert-warning text-center p-4">
        <i class="fa-solid fa-circle-exclamation fa-2x mb-2"></i>
        <p>Tidak ditemukan data BMW untuk "<strong>${keyword}</strong>"</p>
        <small class="text-secondary">Pastikan kata kunci teknis (contoh: N20, E46, 2C58, torque, timing chain)</small>
      </div>
    `;
    return;
  }

  let html = `<p class="text-secondary small">Ditemukan ${results.length} hasil dari database BMW</p><div class="row g-3">`;
  results.forEach(item => {
    html += `
      <div class="col-12">
        <div class="card-glow p-3" style="border-left: 4px solid #1a8cff;">
          <div class="d-flex justify-content-between align-items-start flex-wrap">
            <h5 class="fw-bold text-white">${item.title}</h5>
            <span class="badge bg-info text-dark">${item.category}</span>
          </div>
          <p class="text-secondary mt-2">${item.content}</p>
          <div class="d-flex justify-content-between mt-2">
            <small class="text-muted"><i class="fa-solid fa-book me-1"></i>Sumber: ${item.source}</small>
            <small class="text-muted"><i class="fa-solid fa-tags me-1"></i>${item.keywords.join(', ')}</small>
          </div>
        </div>
      </div>
    `;
  });
  html += '</div>';
  resultDiv.innerHTML = html;
};

console.log('✅ AKA BMW ISGM — Knowledge Base siap!');
