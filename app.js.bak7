window.showVehicleHistory = async function() {
  const vehicleId = document.getElementById('historyVehicleInput')?.value.trim();
  const resultDiv = document.getElementById('historyResult');
  if (!vehicleId) {
    resultDiv.innerHTML = '<p style="color:#f87171;">❌ Masukkan Vehicle ID!</p>';
    return;
  }
  try {
    const snap = await db.collection('work_orders')
      .where('vehicleId', '==', vehicleId)
      .orderBy('createdAt', 'desc')
      .get();
    const history = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    if (history.length === 0) {
      resultDiv.innerHTML = '<p style="color:#6a7f9a;">Tidak ada riwayat servis</p>';
    } else {
      let html = '<table><thead><tr><th>WO</th><th>Status</th><th>Tanggal</th></tr></thead><tbody>';
      history.forEach(w => {
        html += `<tr><td>${w.woNumber || '-'}</td><td>${w.status || '-'}</td><td>${w.createdAt?.toDate?.()?.toLocaleDateString() || '-'}</td></tr>`;
      });
      html += '</tbody></table>';
      resultDiv.innerHTML = html;
    }
  } catch (err) {
    resultDiv.innerHTML = `<p style="color:#f87171;">❌ ${err.message}</p>`;
  }
};

