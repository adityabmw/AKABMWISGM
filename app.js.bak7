});

// ========================== MODULE PURCHASE ORDER ==========================
function generatePONumber() { const el = document.getElementById("poNumber"); if (el) el.value = "PO-" + Date.now().toString().slice(-6); }

document.getElementById("btnAddPOItem")?.addEventListener("click", async function() {
  const pSel = document.getElementById("poPart");
  const qty = parseInt(document.getElementById("poQty").value) || 0;
  const price = parseFloat(document.getElementById("poPrice").value) || 0;
  if (!pSel.value || qty <= 0 || price <= 0) { alert("⚠️ Parameter purchasing barang tidak valid!"); return; }
  
  const pSnap = await getDoc(doc(db, "parts", pSel.value));
  if (!pSnap.exists()) return;
  poItems.push({ partId: pSel.value, partName: pSnap.data().partName, qty, price, total: qty * price });
  renderPOItemsTable();
});

function renderPOItemsTable() {
  const div = document.getElementById("poItemTable");
  if (!div) return;
  let html = '<table class="table table-sm table-bordered border-secondary small"><thead><tr><th>Nama Barang</th><th>Qty</th><th>Harga Beli</th><th>Subtotal</th></tr></thead><tbody>';
  let subtotal = 0;
  poItems.forEach(item => {
    subtotal += item.total;
    html += `<tr><td>${item.partName}</td><td>${item.qty} unit</td><td>${formatRupiah(item.price)}</td><td>${formatRupiah(item.total)}</td></tr>`;
  });
  html += '</tbody></table>';
  div.innerHTML = poItems.length === 0 ? "" : html;
  document.getElementById("poSubtotal").value = subtotal;
  const tax = parseFloat(document.getElementById("poTax").value) || 0;
  document.getElementById("poGrandTotal").value = subtotal + (subtotal * tax / 100);
}

document.getElementById("btnSavePO")?.addEventListener("click", async function() {
  const sSel = document.getElementById("poSupplier");
  if (!sSel.value || poItems.length === 0) { alert("⚠️ Supplier & Minimal 1 item belanja PO wajib terisi!"); return; }
  
  const data = {
    poNumber: document.getElementById("poNumber").value,
    poDate: document.getElementById("poDate").value,
    supplierId: sSel.value, supplierName: sSel.options[sSel.selectedIndex].dataset.name,
    items: poItems,
    subtotal: parseFloat(document.getElementById("poSubtotal").value),
    taxPercent: parseFloat(document.getElementById("poTax").value),
    grandTotal: parseFloat(document.getElementById("poGrandTotal").value),
    status: document.getElementById("poStatus").value,
    createdAt: new Date().toISOString()
  };
  await addDoc(collection(db, "purchaseorders"), data);
  alert("✅ Formulir Purchase Order sukses disimpan!");
  poItems = []; renderPOItemsTable();
  generatePONumber();
  logActivity('PO','Create PO','No: ' + data.poNumber);
});

function renderPurchaseOrders(snap) {
  const tbody = document.getElementById("purchaseOrderTable");
  if (!tbody) return;
  if (snap.empty) { tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">Belum ada invoice PO terbit.</td></tr>'; return; }
  let html = "";
  snap.forEach(doc => {
    const d = doc.data();
    html += `<tr>
      <td><span class="badge bg-dark text-info">${d.poNumber}</span></td>
      <td>${d.supplierName}</td>
      <td>${formatRupiah(d.grandTotal)}</td>
      <td><span class="badge bg-warning text-dark">${d.status}</span></td>
      <td>${d.poDate || '-'}</td>
      <td><button class="btn btn-sm btn-outline-success" onclick="closePO('${doc.id}')">Received</button></td>
    </tr>`;
  });
  tbody.innerHTML = html;
}

window.closePO = async function(id) {
  if (confirm("Konfirmasi penerimaan barang kiriman supplier (Stok gudang otomatis bertambah)?")) {
    const poRef = doc(db, "purchaseorders", id);
    const poSnap = await getDoc(poRef);
    if (!poSnap.exists()) return;
    const poData = poSnap.data();
    
    for (let item of poData.items) {
      const pRef = doc(db, "parts", item.partId);
      const pSnap = await getDoc(pRef);
      if (pSnap.exists()) {
        let currentStock = parseInt(pSnap.data().stock) || 0;
        await updateDoc(pRef, { stock: currentStock + item.qty });
      }
    }
    await updateDoc(poRef, { status: "RECEIVED" });
    alert("✅ Barang kliring masuk logistik gudang!");
    logActivity('PO','Receive Goods','PO ID: ' + id);
  }
};

// ========================== MODULE ESTIMATION ==========================
function generateEstimationNumber() { const el = document.getElementById("estimationNumber"); if (el) el.value = "EST-" + Date.now().toString().slice(-6); }

function calculateEstimationValues() {
  const labor = parseFloat(document.getElementById("estimationLabor").value) || 0;
  const parts = parseFloat(document.getElementById("estimationParts").value) || 0;
  const disc = parseFloat(document.getElementById("estimationDiscount").value) || 0;
  const taxRate = parseFloat(document.getElementById("estimationTax").value) || 0;
  
  const sub = labor + parts - disc;
  document.getElementById("estimationGrandTotal").value = sub + (sub * taxRate / 100);
}
["estimationLabor","estimationParts","estimationDiscount","estimationTax"].forEach(id => {
  document.getElementById(id)?.addEventListener("input", calculateEstimationValues);
});

document.getElementById("btnSaveEstimation")?.addEventListener("click", async function() {
  const woSel = document.getElementById("estimationWO");
  if (!woSel.value) { alert("⚠️ Silakan tentukan target Work Order!"); return; }
  
  const data = {
    estNumber: document.getElementById("estimationNumber").value,
    estDate: document.getElementById("estimationDate").value,
    woId: woSel.value, woNumber: woSel.options[woSel.selectedIndex].dataset.wonumber,
    customerName: document.getElementById("estimationCustomer").value,
    laborCost: parseFloat(document.getElementById("estimationLabor").value) || 0,
    partsCost: parseFloat(document.getElementById("estimationParts").value) || 0,
    discount: parseFloat(document.getElementById("estimationDiscount").value) || 0,
    taxPercent: parseFloat(document.getElementById("estimationTax").value) || 11,
    grandTotal: parseFloat(document.getElementById("estimationGrandTotal").value) || 0,
    status: document.getElementById("estimationStatus").value,
    note: document.getElementById("estimationNote").value.trim(),
    createdAt: new Date().toISOString()
  };
  await addDoc(collection(db, "estimations"), data);
  alert("✅ Surat penawaran biaya estimasi resmi tersimpan!");
  generateEstimationNumber();
  logActivity('ESTIMATION','Generate Penawaran','No: ' + data.estNumber);
});

function renderEstimations(snap) {
  const tbody = document.getElementById("estimationTable");
  if (!tbody) return;
  if (snap.empty) { tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Belum ada list estimasi keluar.</td></tr>'; return; }
  let html = "";
  snap.forEach(doc => {
    const d = doc.data();
    html += `<tr>
      <td>${d.estNumber}</td>
      <td>${d.woNumber}</td>
      <td>${d.customerName}</td>
      <td>${formatRupiah(d.grandTotal)}</td>
      <td><span class="badge bg-dark border text-warning">${d.status}</span></td>
      <td>${d.estDate || '-'}</td>
      <td><button class="btn btn-sm btn-success py-0" onclick="updateEstStatus('${doc.id}','APPROVED')">Approve</button></td>
    </tr>`;
  });
  tbody.innerHTML = html;
}

window.updateEstStatus = async function(id, status) {
  await updateDoc(doc(db, "estimations", id), { status: status });
  alert("✅ Konfirmasi status lembar estimasi dikunci!");
};

// ========================== MODULE INVOICE ==========================
function generateInvoiceNumber() { const el = document.getElementById("invoiceNumber"); if (el) el.value = "INV-" + Date.now().toString().slice(-6); }

function calculateInvoiceValues() {
  const sub = parseFloat(document.getElementById("invoiceSubtotal").value) || 0;
  const disc = parseFloat(document.getElementById("invoiceDiscount").value) || 0;
  const taxRate = parseFloat(document.getElementById("invoiceTax").value) || 0;
  
  const net = sub - disc;
  document.getElementById("invoiceGrandTotal").value = net + (net * taxRate / 100);
}
["invoiceSubtotal","invoiceDiscount","invoiceTax"].forEach(id => {
  document.getElementById(id)?.addEventListener("input", calculateInvoiceValues);
});

document.getElementById("btnSaveInvoice")?.addEventListener("click", async function() {
  const woSel = document.getElementById("invoiceWO");
  if (!woSel.value) { alert("⚠️ Target referensi data WO wajib diisi!"); return; }
  
  const data = {
    invNumber: document.getElementById("invoiceNumber").value,
    invDate: document.getElementById("invoiceDate").value,
    woId: woSel.value, woNumber: woSel.options[woSel.selectedIndex].dataset.wonumber,
    customerName: document.getElementById("invoiceCustomer").value,
    subtotal: parseFloat(document.getElementById("invoiceSubtotal").value) || 0,
    discount: parseFloat(document.getElementById("invoiceDiscount").value) || 0,
    taxPercent: parseFloat(document.getElementById("invoiceTax").value) || 11,
    grandTotal: parseFloat(document.getElementById("invoiceGrandTotal").value) || 0,
    status: document.getElementById("invoiceStatus").value,
    paidAmount: 0,
    createdAt: new Date().toISOString()
  };
  await addDoc(collection(db, "invoices"), data);
  alert("✅ Billing Invoice Faktur Sukses Diaktivasi!");
  generateInvoiceNumber();
  logActivity('INVOICE','Create Invoice','No: ' + data.invNumber);
});

function renderInvoices(snap) {
  const tbody = document.getElementById("invoiceTable");
  if (!tbody) return;
  if (snap.empty) { tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">Belum ada riwayat tagihan invoice.</td></tr>'; return; }
  let html = "", totalInv = 0, totalPaid = 0, unpaidCount = 0;
  snap.forEach(doc => {
    const d = doc.data();
    if (d.status !== "VOID") {
      totalInv += d.grandTotal || 0;
      totalPaid += d.paidAmount || 0;
      if (d.status === "UNPAID") unpaidCount++;
    }
    html += `<tr><td><span class="badge bg-dark text-warning">${d.invNumber}</span></td><td>${d.customerName}</td><td>${d.woNumber}</td><td>${formatRupiah(d.grandTotal)}</td><td><span class="badge bg-danger">${d.status}</span></td><td>${d.invDate || '-'}</td></tr>`;
  });
  tbody.innerHTML = html;
  
  document.getElementById("invoiceTotalLabel").innerText = formatRupiah(totalInv);
  document.getElementById("invoicePaidLabel").innerText = formatRupiah(totalPaid);
  document.getElementById("invoiceBalanceLabel").innerText = formatRupiah(totalInv - totalPaid);
  document.getElementById("cardInvoice").innerText = unpaidCount;
  
  document.getElementById("cardRevenueToday").innerText = formatRupiah(totalPaid);
  document.getElementById("cardRevenueMonth").innerText = formatRupiah(totalPaid);
  
  updateChartsVisual(snap);
}

function updateInvoiceDropdown(snap) {
  const sel = document.getElementById("paymentInvoice");
  if (!sel) return;
  const val = sel.value;
  sel.innerHTML = '<option value="">Pilih Dokumen Invoice</option>';
  snap.forEach(doc => {
    const d = doc.data();
    if (d.status === "PAID" || d.status === "VOID") return;
    const opt = document.createElement("option");
    opt.value = doc.id;
    opt.dataset.invnumber = d.invNumber;
    opt.dataset.custname = d.customerName;
    opt.dataset.sisa = d.grandTotal - (d.paidAmount || 0);
    opt.textContent = `${d.invNumber} - ${d.customerName} (Sisa Tagihan: ${formatRupiah(opt.dataset.sisa)})`;
    sel.appendChild(opt);
  });
  sel.value = val;
}

document.getElementById("paymentInvoice")?.addEventListener("change", function() {
  const target = document.getElementById("paymentCustomer");
  if (!target) return;
  if (!this.value) { target.value = ""; return; }
  const opt = this.options[this.selectedIndex];
  target.value = opt.dataset.custname;
  document.getElementById("paymentAmount").value = opt.dataset.sisa;
});

// ========================== MODULE CASHIER (PAYMENTS) ==========================
function generatePaymentNumber() { const el = document.getElementById("paymentNumber"); if (el) el.value = "PAY-" + Date.now().toString().slice(-6); }

document.getElementById("btnSavePayment")?.addEventListener("click", async function() {
  const invSel = document.getElementById("paymentInvoice");
  const amount = parseFloat(document.getElementById("paymentAmount").value) || 0;
  if (!invSel.value || amount <= 0) { alert("⚠️ Nominal setoran dana & target invoice wajib valid!"); return; }
  
  const data = {
    paymentNumber: document.getElementById("paymentNumber").value,
    paymentDate: document.getElementById("paymentDate").value,
    invoiceId: invSel.value, invoiceNumber: invSel.options[invSel.selectedIndex].dataset.invnumber,
    customerName: document.getElementById("paymentCustomer").value,
    method: document.getElementById("paymentMethod").value,
    amount: amount,
    reference: document.getElementById("paymentReference").value.trim(),
    cashier: document.getElementById("paymentCashier").value.trim(),
    createdAt: new Date().toISOString()
  };
  await addDoc(collection(db, "payments"), data);
  
  const invRef = doc(db, "invoices", invSel.value);
  const invSnap = await getDoc(invRef);
  if (invSnap.exists()) {
    let currentPaid = parseFloat(invSnap.data().paidAmount) || 0;
    let finalPaid = currentPaid + amount;
    let status = finalPaid >= parseFloat(invSnap.data().grandTotal) ? "PAID" : "PARTIAL";
    await updateDoc(invRef, { paidAmount: finalPaid, status: status });
  }
  
  alert("✅ Pembayaran Kliring Berhasil Divalidasi!");
  document.getElementById("paymentAmount").value = "";
  document.getElementById("paymentReference").value = "";
  generatePaymentNumber();
  logActivity('PAYMENT','Execute Payment','No: ' + data.paymentNumber);
});

function renderPayments(snap) {
  const tbody = document.getElementById("cashierTable");
  if (!tbody) return;
  if (snap.empty) { tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">Belum ada kas masuk terpantau hari ini.</td></tr>'; return; }
  
  let html = "", c = 0, t = 0, q = 0, e = 0;
  snap.forEach(doc => {
    const d = doc.data();
    const method = d.method || "CASH";
    if (method === "CASH") c += d.amount;
    else if (method === "TRANSFER") t += d.amount;
    else if (method === "QRIS") q += d.amount;
    else if (method === "EDC") e += d.amount;
    
    html += `<tr><td><strong>${d.paymentNumber}</strong></td><td>${d.invoiceNumber}</td><td><span class="badge bg-success">${method}</span></td><td>${formatRupiah(d.amount)}</td><td>${d.paymentDate || '-'}</td><td><button class="btn btn-sm btn-outline-danger py-0" onclick="voidPayment('${doc.id}','${d.invoiceId}',${d.amount})">Void</button></td></tr>`;
  });
  tbody.innerHTML = html;
  
  document.getElementById("summaryCash").innerText = formatRupiah(c);
  document.getElementById("summaryTransfer").innerText = formatRupiah(t);
  document.getElementById("summaryQRIS").innerText = formatRupiah(q);
  document.getElementById("summaryEDC").innerText = formatRupiah(e);
}

window.voidPayment = async function(payId, invId, amount) {
  if (confirm("Apakah Anda yakin ingin membatalkan transaksi pembayaran ini (Void)?")) {
    await deleteDoc(doc(db, "payments", payId));
    const invRef = doc(db, "invoices", invId);
    const invSnap = await getDoc(invRef);
    if (invSnap.exists()) {
      let currentPaid = parseFloat(invSnap.data().paidAmount) || 0;
      let finalPaid = Math.max(0, currentPaid - amount);
      await updateDoc(invRef, { paidAmount: finalPaid, status: "UNPAID" });
    }
    alert("✅ Transaksi dianulir.");
    logActivity('PAYMENT','Void Transaction','ID: ' + payId);
  }
};

// ========================== AUDIT SYSTEM SECURITY LOGS ==========================
async function logActivity(module, action, detail) {
  const user = auth.currentUser;
  if (!user) return;
  try {
    const userDoc = await getDoc(doc(db, "users", user.uid));
    const uData = userDoc.exists() ? userDoc.data() : {};
    await addDoc(collection(db, "activitylogs"), {
      userName: uData.Name || "System Staff",
      userRole: uData.Role || "STAFF",
      module, action, detail,
      timestamp: new Date().toISOString()
    });
  } catch(err) { console.warn("Log activity error:", err); }
}

function renderActivityLogs(snap) {
  const tbody = document.getElementById("activityLogTable");
  if (!tbody) return;
  let html = "";
  snap.forEach(doc => {
    const d = doc.data();
    html += `<tr><td><small>${d.timestamp ? d.timestamp.substring(11,19) : '-'}</small></td><td>${d.userName}</td><td>${d.userRole}</td><td><span class="badge bg-secondary">${d.module}</span></td><td><strong>${d.action}</strong></td><td><span class="text-white-50">${d.detail}</span></td></tr>`;
  });
  tbody.innerHTML = html || '<tr><td colspan="6" class="text-center text-muted">Belum ada jejak aktivitas terdeteksi.</td></tr>';
}

// ========================== USER PROFILE SETTINGS ==========================
async function loadUserTable() {
  const table = document.getElementById("userTable");
  if (!table) return;
  try {
    const snap = await getDocs(collection(db, "users"));
    let html = "";
    snap.forEach(doc => {
      const d = doc.data();
      const isActive = d.status === "ACTIVE";
      html += `<tr>
        <td><strong>${d.Name || '-'}</strong></td>
        <td>${d.Email || '-'}</td>
        <td><span class="badge bg-dark border border-info text-info">${d.Role}</span></td>
        <td><span class="badge ${isActive ? 'bg-success':'bg-warning text-dark'}">${d.status || 'PENDING'}</span></td>
        <td><small>${d.lastLogin || '-'}</small></td>
        <td>${!isActive ? `<button class="btn btn-sm btn-success py-0" onclick="approveUser('${doc.id}')">ACC</button>` : '-'}</td>
      </tr>`;
    });
    table.innerHTML = html || '<tr><td colspan="6" class="text-center text-muted">Belum ada data user.</td></tr>';
  } catch(e) { table.innerHTML = `<tr><td colspan="6" class="text-center text-danger">Error: ${e.message}</td></tr>`; }
}

window.approveUser = async function(id) {
  if (confirm("Aktifkan perizinan login sistem untuk user ini?")) {
    await updateDoc(doc(db, "users", id), { status: "ACTIVE" });
    alert("✅ Hak perizinan akses akun berhasil dibuka!");
    loadUserTable();
  }
};

document.getElementById("btnAddUser")?.addEventListener("click", async function() {
  const name = document.getElementById("userName").value.trim();
  const email = document.getElementById("userEmail").value.trim();
  const password = document.getElementById("userPassword").value;
  if (!name || !email || !password) { alert("⚠️ Parameter pembuatan akun user wajib dipenuhi!"); return; }
  try {
    const cred = await createUserWithEmailAndPassword(auth, email, password);
    await setDoc(doc(db, "users", cred.user.uid), {
      Name: name, Email: email, Role: document.getElementById("userRole").value,
      status: document.getElementById("userStatus").value, createdAt: new Date().toISOString()
    });
    alert("✅ Akun user karyawan internal sukses ditambahkan!");
    document.getElementById("userName").value = "";
    document.getElementById("userEmail").value = "";
    document.getElementById("userPassword").value = "";
    loadUserTable();
  } catch(err) { alert("❌ Gagal mendaftarkan user: " + err.message); }
});

document.getElementById("btnSaveSettings")?.addEventListener("click", function() {
  alert("✅ Corporate Core Profile AKA BMW Service Berhasil Disinkronisasi!");
});

// ========================== MODULE KNOWLEDGE: INTEGRASI ETK OFFLINE 3.2.20 ==========================
const ETK_SOURCES = {
  etkoffline: {
    name: 'BMW ETK Desktop Offline',
    url: '',
    urlPart: '',
    canIframe: false,
    info: '<strong>BMW ETK Offline App (v3.2.20)</strong> – Menggunakan database Transbase lokal laptop. Sistem akan menyalin sasis secara otomatis ke memori Windows Anda.'
  },
  realoem: {
    name: 'RealOEM',
    url: 'https://www.realoem.com/bmw/en/select?vin=',
    urlPart: 'https://www.realoem.com/bmw/en/part?id=',
    canIframe: true,
    info: '<strong>RealOEM</strong> – database terakhir 2019 (cocok untuk sasis lawas).'
  },
  bimmercat: {
    name: 'BimmerCat',
    url: 'https://bimmercat.com/bmw/vin/decoder/',
    urlPart: 'https://bimmercat.com/bmw/part/',
    canIframe: true,
    info: '<strong>BimmerCat</strong> – database terakhir 2019 (cocok untuk sasis lawas).'
  },
  bimmerrefs: {
    name: 'BimmerRefs',
    url: 'https://bimmerrefs.com/vin/',
    urlPart: 'https://bimmerrefs.com/part/',
    canIframe: false,
    info: '<strong>BimmerRefs</strong> – database update sampai G-series & model terbaru.'
  }
};

window.resetEtkForm = function() {
  ["etkVin","etkPartNumber"].forEach(id => { const el = document.getElementById(id); if (el) el.value = ""; });
  closeEtkResult();
};

window.closeEtkResult = function() {
  const container = document.getElementById("etkResultContainer"); if (container) container.style.display = "none";
  const iframe = document.getElementById("etkResultIframe"); if (iframe) iframe.src = "";
};

document.getElementById("btnEtkSearch")?.addEventListener("click", function() {
  let vin = document.getElementById("etkVin").value.trim().toUpperCase();
  const partNumber = document.getElementById("etkPartNumber").value.trim();
  const source = document.getElementById("etkSource").value;
  
  if (!vin && !partNumber) {
    alert("⚠️ Parameter kosong! Masukkan nomor VIN Sasis atau Part Number terlebih dahulu.");
    return;
  }
  
  if (vin) {
    const cleanedVin = vin.replace(/[^A-Z0-9]/g, '');
    if (cleanedVin.length !== 7 && cleanedVin.length !== 17) {
      alert("❌ Format VIN salah! Sasis BMW harus berjumlah 7 digit atau 17 digit.");
      return;
    }
    if (/[IOQ]/.test(cleanedVin)) {
      alert("❌ Karakter I, O, atau Q tidak valid dalam standarisasi sasis BMW.");
      return;
    }
    vin = cleanedVin;
    document.getElementById("etkVin").value = vin;
  }
  
  const sourceData = ETK_SOURCES[source];
  if (!sourceData) return;
  
  // LOGIKA UTAMA SINKRONISASI COPIER UNTUK APLIKASI ETK LAPTOP
  if (source === 'etkoffline') {
    const textToCopy = vin ? vin : partNumber;
    const hiddenTextArea = document.createElement("textarea");
    hiddenTextArea.value = textToCopy;
    hiddenTextArea.style.position = "fixed";
    document.body.appendChild(hiddenTextArea);
    hiddenTextArea.select();
    
    try {
      document.execCommand("copy");
      alert(`📋 AUTOMATION SUCCESS!\n\nNomor sasis/part [ ${textToCopy} ] telah disalin otomatis ke Windows Clipboard.\n\nLangkah Mekanik:\n1. Buka aplikasi BMW ETK di laptop.\n2. Klik kotak input VIN/Sasis.\n3. Tekan tombol kombinasi Ctrl + V lalu Enter.`);
    } catch (err) {
      alert("❌ Gagal menyalin otomatis, silakan salin manual.");
    }
    
    document.body.removeChild(hiddenTextArea);
    closeEtkResult();
    return;
  }
  
  let searchUrl = "";
  if (vin) {
    searchUrl = sourceData.url + vin;
  } else if (partNumber) {
    searchUrl = sourceData.urlPart + partNumber;
  }
  
  if (!sourceData.canIframe) {
    window.open(searchUrl, '_blank');
  } else {
    const container = document.getElementById("etkResultContainer");
    const iframe = document.getElementById("etkResultIframe");
    const title = document.getElementById("etkResultTitle");
    
    if (container && iframe) {
      container.style.display = "block";
      iframe.src = searchUrl;
      if (title) title.innerText = vin ? "Hasil Sasis: " + vin : "Hasil Part: " + partNumber;
      container.scrollIntoView({ behavior: "smooth" });
    }
  }
});

function updateWACustomerDropdown(snap) {
  const sel = document.getElementById("waCustomer"); if (!sel) return;
  const val = sel.value; sel.innerHTML = '<option value="">Pilih Customer</option>';
  snap.forEach(doc => {
    const d = doc.data();
    if(d.phone) {
      const opt = document.createElement("option");
      opt.value = d.phone; opt.textContent = `${d.name} (${d.phone})`;
      sel.appendChild(opt);
    }
  });
  sel.value = val;
}

function renderWACustomerList(snap) {
  const tbody = document.getElementById("waCustomerList"); if (!tbody) return;
  let html = "";
  snap.forEach(doc => {
    const d = doc.data();
    if(d.phone) {
      let cleanNum = d.phone.replace(/[^0-9]/g, '');
      if (cleanNum.startsWith('0')) cleanNum = '62' + cleanNum.substring(1);
      const link = `https://wa.me/${cleanNum}`;
      html += `<tr><td>${d.name}</td><td>${d.phone}</td><td><a href="${link}" target="_blank" class="whatsapp-btn"><i class="fa-brands fa-whatsapp"></i> Chat Direct</a></td></tr>`;
    }
  });
  tbody.innerHTML = html || '<tr><td colspan="3" class="text-center text-muted">Tidak ada kontak nomor HP.</td></tr>';
}

document.getElementById("btnWaSend")?.addEventListener("click", function() {
  const phone = document.getElementById("waCustomer").value;
  const template = document.getElementById("waQuickMessage").value;
  const custom = document.getElementById("waCustomMessage").value.trim();
  const text = custom || template;
  if (!phone || !text) { alert("⚠️ Tentukan customer & isi pesan teks!"); return; }
  
  let cleanNum = phone.replace(/[^0-9]/g, '');
  if (cleanNum.startsWith('0')) cleanNum = '62' + cleanNum.substring(1);
  window.open(`https://wa.me/${cleanNum}?text=${encodeURIComponent(text)}`, '_blank');
});

// ========================== CORE VISUAL DASHBOARD CHARTS ENGINE ==========================
function updateChartsVisual(invoiceSnap) {
  const ctxRevenue = document.getElementById("revenueChart");
  const ctxStatus = document.getElementById("woStatusChart");
  
  if (ctxRevenue) {
    const dataValues = [12000000, 19000000, 32000000, 5000000, 24000000, 45000000];
    let liveCollected = 0;
    invoiceSnap.forEach(doc => { if(doc.data().status === "PAID") liveCollected += doc.data().grandTotal || 0; });
    dataValues[dataValues.length - 1] = liveCollected;
    
    if (revenueChartInstance) revenueChartInstance.destroy();
    revenueChartInstance = new Chart(ctxRevenue.getContext("2d"), {
      type: "line",
      data: {
        labels: ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun"],
        datasets: [{ label: "Pendapatan Bersih Terkliring", data: dataValues, borderColor: "#06d6a0", backgroundColor: "rgba(6,214,160,0.08)", tension: 0.2, fill: true }]
      },
      options: { responsive: true, plugins: { legend: { labels: { color: "#fff" } } } }
    });
  }
  
  if (ctxStatus) {
    if (woStatusChartInstance) woStatusChartInstance.destroy();
    woStatusChartInstance = new Chart(ctxStatus.getContext("2d"), {
      type: "doughnut",
      data: {
        labels: ["CHECK_IN", "DIAGNOSA", "PROSES", "SELESAI"],
        datasets: [{ data: [3, 2, 5, 4], backgroundColor: ["#8a9bb5", "#ffb703", "#00b4d8", "#06d6a0"] }]
      },
      options: { responsive: true, plugins: { legend: { labels: { color: "#fff" } } } }
    });
  }
}

