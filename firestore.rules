rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(role) { return isAuthenticated() && (getUserData().role == role || getUserData().Role == role); }
    function isUserActive() { return isAuthenticated() && getUserData().status == 'ACTIVE'; }

    match /users/{userId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR'));
    }
    match /customers/{customerId} {
      allow read: if isUserActive();
      allow write: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('SERVICE_ADVISOR') || hasRole('CASHIER'));
    }
    match /vehicles/{vehicleId} {
      allow read: if isUserActive();
      allow write: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('SERVICE_ADVISOR') || hasRole('FOREMAN'));
    }
    match /checkins/{checkinId} {
      allow read: if isUserActive();
      allow write: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('SERVICE_ADVISOR'));
    }
    match /workorders/{woId} {
      allow read: if isUserActive();
      allow create: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('SERVICE_ADVISOR'));
      allow update: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('SERVICE_ADVISOR') || hasRole('FOREMAN') || hasRole('MECHANIC'));
      allow delete: if isUserActive() && hasRole('OWNER');
    }
    match /parts/{partId} {
      allow read: if isUserActive();
      allow create, delete: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('INVENTORY'));
      allow update: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('INVENTORY') || hasRole('SERVICE_ADVISOR') || hasRole('FOREMAN'));
    }
    match /purchaseorders/{poId} {
      allow read: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('INVENTORY') || hasRole('CASHIER'));
      allow write: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('INVENTORY'));
    }
    match /invoices/{invoiceId} {
      allow read: if isUserActive();
      allow write: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('CASHIER'));
    }
    match /payments/{paymentId} {
      allow read, create: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR') || hasRole('CASHIER'));
      allow update: if false;
      allow delete: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR'));
    }
    match /activitylogs/{logId} {
      allow read: if isUserActive() && (hasRole('OWNER') || hasRole('ADMINISTRATOR'));
      allow create: if isUserActive();
      allow update, delete: if false;
    }
  }
}
